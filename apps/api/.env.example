# Aurora/ClinWrite API — environment variables
# Copy to .env.local for local dev; never commit real values.
#
# On the standalone VPS this file's SECRET entries live in sops-encrypted
# .env.enc files (per ADR 0006 + ADR 0009); LOW-SENSITIVITY entries live
# in plain .env. The app's SecretsProvider interface reads from whichever
# backend is configured.

# ----- Core -----
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug

# ----- Database -----
# Local dev: direct Postgres connection string.
# Staging/prod: value comes from AWS Secrets Manager; see DATABASE_URL_SECRET_NAME below.
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_dev?schema=public

# In staging/prod the API reads this Secrets Manager entry at boot (ADR 0006).
# Local dev leaves this blank and uses DATABASE_URL directly.
DATABASE_URL_SECRET_NAME=

# ----- Auth -----
# JWT signing secret for session tokens (rotated per environment, >=256-bit).
# In staging/prod sourced from Secrets Manager via JWT_SECRET_NAME.
JWT_SECRET=change-me-local-only
JWT_SECRET_NAME=
JWT_EXPIRY=24h

# SSO via WorkOS (ADR 0005). Local dev uses SSO_PROVIDER=mock for a fake login.
SSO_PROVIDER=mock  # mock | workos
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3001/auth/callback

# ----- MFA -----
MFA_ISSUER=Aurora
MFA_WINDOW_SECONDS=30

# ----- CORS -----
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ----- LLM (per ADR 0004) -----
LLM_PROVIDER=anthropic  # anthropic | azure-openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# Azure OpenAI fallback
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ----- Secrets backend (per ADR 0006) -----
# Standalone VPS: 'sops' — reads from /opt/platform/env/*.env.enc
# AWS year 2:     'aws-secrets-manager'
SECRETS_PROVIDER=sops
SOPS_AGE_KEY_FILE=/etc/platform/age.key

# ----- Object storage (per ADR 0007 — MinIO on standalone, S3 on cloud) -----
# S3-API compatible — the AWS SDK S3Client points at this endpoint on standalone
# and at the real S3 endpoint after cloud migration.
S3_ENDPOINT=http://localhost:9000     # MinIO; blank on AWS to use default
S3_REGION=us-east-1                   # arbitrary on MinIO; real region on AWS
S3_FORCE_PATH_STYLE=true              # true for MinIO; false for AWS
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=minio-local-password
S3_DOCUMENTS_BUCKET=platform-documents
S3_VOICE_BUCKET=platform-voice
S3_EXPORTS_BUCKET=platform-exports
S3_ECTD_BUCKET=platform-ectd

# ----- Queue (per ADR 0008 — BullMQ on Redis) -----
# Standalone: local Redis via docker-compose.local.yml
# Cloud:      ElastiCache endpoint
REDIS_URL=redis://:local-redis-password@localhost:6379

# ----- Observability -----
OTEL_SERVICE_NAME=platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ----- Compliance -----
# Audit trail secret used in hash chain; MUST be rotated per environment and backed up.
AUDIT_HASH_SECRET=change-me-local-only

# ----- Feature flags -----
FEATURE_AI_GATEWAY=true
FEATURE_PRESENCE=true
