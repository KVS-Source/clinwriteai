# Aurora/ClinWrite API — environment variables
# Copy to .env.local for local dev; never commit real values.

# ----- Core -----
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug

# ----- Database -----
# Postgres connection string; use a dedicated DB per environment.
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_dev?schema=public

# ----- Auth -----
# JWT signing secret for session tokens (rotated per environment, >=256-bit).
JWT_SECRET=change-me-local-only
JWT_EXPIRY=24h

# SSO provider configuration (set per ADR 0005 outcome).
SSO_PROVIDER=mock  # mock | entra | okta | auth0
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ISSUER_URL=
SSO_REDIRECT_URI=http://localhost:3001/auth/callback

# ----- MFA -----
MFA_ISSUER=Aurora
MFA_WINDOW_SECONDS=30

# ----- CORS -----
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ----- LLM (per ADR 0004) -----
LLM_PROVIDER=anthropic  # anthropic | azure-openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# Azure OpenAI fallback
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ----- Object storage (document binaries, voice notes) -----
S3_ENDPOINT=
S3_BUCKET=platform-documents-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----- Queue (per ADR 0008) -----
# BullMQ with Redis is the Phase 0 placeholder; switch per ADR 0008.
REDIS_URL=redis://localhost:6379

# ----- Observability -----
OTEL_SERVICE_NAME=platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ----- Compliance -----
# Audit trail secret used in hash chain; MUST be rotated per environment and backed up.
AUDIT_HASH_SECRET=change-me-local-only

# ----- Feature flags -----
FEATURE_AI_GATEWAY=true
FEATURE_PRESENCE=true
