// Aurora/ClinWrite — Prisma schema
// Phase 0: skeleton with datasource + generator only.
// Phase 1 Week 3: Platform + Project models land here (~20 tables).
// Phase 3A–3E: per-module models land here.
//
// Per ADR 0002: Prisma for app-level data; audit_events uses raw SQL migration.
// Per ADR 0003: pgvector extension enabled for Claims Matrix similarity (Phase 3C).

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]  // enabled now; used from Phase 3C
}

