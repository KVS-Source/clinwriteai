// Module A — Clinical Writing models.
//
// Source: docs/demo/02-datamodel.md §4-§6 (documents, checklist, comments).
// Enum columns are stored as TEXT with Zod validation at the API edge; the
// architecture decision (plan §2) is to keep enums in app code until Phase 3
// stabilises, then migrate to Postgres ENUMs.
//
// What's HERE in this scaffold:
//   - documents + document_versions + section_contents + provenance_records
//   - checklist_templates / checklist_template_items / checklist_instances / items
//   - comments
//
// What's NOT here yet (ships in later Module A sessions):
//   - voice_notes (needs S3 wiring)
//   - signatures / signature chains (Part 11 — compliance review required)
//   - crm_meetings + crm_resolutions (post-review workflow)
//   - presence_sessions (Socket.io + Redis pub/sub)
//   - tlf_items (needs CSR fixture modelling)
//   - meddra_lookup (needs licensing)

// --------------------------------------------------------------------------
// 4.1 documents
// --------------------------------------------------------------------------

model Document {
  id                     String    @id @default(uuid())
  projectId              String
  type                   String    // document_type — csr_full | csr_synopsis | protocol | …
  title                  String
  status                 String    @default("not_started")  // document_status
  stage                  String    @default("study_start_up") // document_stage
  therapeuticArea        String                                // immutable per FR-A-002
  templateId             String?                               // FK to document_templates (future)
  assigneeId             String
  currentVersionId       String?   @unique                     // set after first save
  targetCompletionDate   DateTime?
  submittedForReviewAt   DateTime?
  signedAt               DateTime?
  watermarked            Boolean   @default(true)              // cleared on final sign-off
  createdBy              String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  versions               DocumentVersion[]   @relation("DocumentVersions")
  currentVersion         DocumentVersion?    @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  checklistInstance      ChecklistInstance?
  comments               Comment[]
  ichWaivers             IchSectionWaiver[]

  @@map("documents")
  @@index([projectId])
  @@index([status])
  @@index([stage])
  @@index([assigneeId])
}

// --------------------------------------------------------------------------
// 4.2 document_versions
// --------------------------------------------------------------------------

model DocumentVersion {
  id              String   @id @default(uuid())
  documentId      String
  versionNumber   String                                       // "v0.1", "v0.2", …
  label           String                                       // "Draft" | "For Review" | "Final"
  contentHash     String                                       // sha256 of full document content — binds to e-sig
  isCurrent       Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  restoreSource   Json?                                        // {fromVersionId, sections[], reason} when restored

  document        Document              @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  sections        SectionContent[]
  provenance      ProvenanceRecord[]
  currentOf       Document?             @relation("DocumentCurrentVersion")

  @@map("document_versions")
  @@unique([documentId, versionNumber])
  @@index([documentId])
}

// --------------------------------------------------------------------------
// 4.3 section_contents
// --------------------------------------------------------------------------

model SectionContent {
  id                 String   @id @default(uuid())
  documentVersionId  String
  sectionId          String                                    // "11.4.1" etc.
  sectionNumber      String
  sectionTitle       String
  contentHtml        String   @default("")
  ichStatus          String   @default("not_started")           // ich_section_status
  wordCount          Int      @default(0)
  aiSpanCount        Int      @default(0)
  humanSpanCount     Int      @default(0)
  lastEditedBy       String?
  lastEditedAt       DateTime?

  version            DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@map("section_contents")
  @@unique([documentVersionId, sectionId])
  @@index([documentVersionId])
  @@index([ichStatus])
}

// --------------------------------------------------------------------------
// 4.4 provenance_records — immutable Part 11 AI provenance (FR-A-021)
// --------------------------------------------------------------------------

model ProvenanceRecord {
  id                 String   @id @default(uuid())
  documentVersionId  String
  sectionId          String
  spanId             String                                     // unique within section
  spanText           String
  sourceType         String                                     // ai_draft | human | restored
  sourceRef          String?                                    // TLF ref, SAP section, etc.
  aiModel            String?                                    // null if source_type=human
  aiGeneratedAt      DateTime?
  acceptedBy         String?
  acceptedAt         DateTime?
  createdAt          DateTime @default(now())

  version            DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@map("provenance_records")
  @@index([documentVersionId])
  @@index([documentVersionId, sectionId])
  @@index([spanId])
}

// --------------------------------------------------------------------------
// 4.4b source_references — immutable reference links (FR-A-022)
// A span of text in a document section, linked to an uploaded source document
// (optionally with a page / section locator). Append-only: a DB trigger rejects
// UPDATE and DELETE, so the traceability record cannot be altered once created.
// --------------------------------------------------------------------------

model SourceReference {
  id          String   @id @default(uuid())
  documentId  String
  sectionId   String
  spanText    String                                           // the cited text, as selected in the editor
  uploadId    String                                           // document_uploads.id (the source file)
  page        Int?                                             // 1-based page in a PDF
  locator     String?                                          // free-text pointer, e.g. "§9.4 Table 3"
  startOffset Int?                                             // range in the section's whitespace-collapsed text
  endOffset   Int?                                             //   (null on references made before ranges were stored)
  createdBy   String
  createdAt   DateTime @default(now())

  @@map("source_references")
  @@index([documentId, sectionId])
  @@index([uploadId])
}

// --------------------------------------------------------------------------
// 4.4c source_reference_removals — a reference link withdrawn by a user
// The reference row itself stays (immutable, FR-A-022); a removal is a separate
// append-only record, and lists skip references that have one. Same trigger.
// --------------------------------------------------------------------------

model SourceReferenceRemoval {
  id          String   @id @default(uuid())
  referenceId String   @unique                                  // source_references.id
  documentId  String
  reason      String?
  removedBy   String
  removedAt   DateTime @default(now())

  @@map("source_reference_removals")
  @@index([documentId])
}

// --------------------------------------------------------------------------
// 4.4c document_sources — which uploaded source documents a document is based on.
// Many-to-many; span-level citations stay in source_references.
// --------------------------------------------------------------------------

model DocumentSource {
  documentId  String
  uploadId    String
  linkedBy    String
  createdAt   DateTime @default(now())

  @@id([documentId, uploadId])
  @@map("document_sources")
  @@index([uploadId])
}

// --------------------------------------------------------------------------
// 4.5 version_restore_jobs — async restore workflow
// --------------------------------------------------------------------------

model VersionRestoreJob {
  id                 String    @id @default(uuid())
  sourceDocumentId   String
  createdVersionId   String?                                    // populated on completion
  sectionsRestored   Json                                       // [{sectionId, fromVersionId}]
  reason             String
  status             String    @default("pending")              // pending | complete | failed
  createdBy          String
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  @@map("version_restore_jobs")
  @@index([sourceDocumentId])
}

// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// 11.1 crm_meetings — Cross-functional Review Meetings
// --------------------------------------------------------------------------
//
// Flow:
//   doc.status='in_review' → schedule a CRM meeting
//   meeting status: scheduled → in_progress (chair starts) → complete (chair ends)
//   on 'in_progress': doc.status flips to 'crm_in_progress' atomically
//   on 'complete' (with all comments resolved): doc.status → 'pending_signature'
//
// meeting_ref 'CRM-###' is human-readable + application-generated, same
// pattern as Module A comments.

model CrmMeeting {
  id              String   @id @default(uuid())
  documentId      String
  meetingRef      String   @unique                                  // 'CRM-###'
  chairId         String                                           // User.id
  status          String   @default("scheduled")                     // scheduled | in_progress | complete | cancelled
  scheduledDate   DateTime @db.Date
  startTime       String                                           // '14:00 UTC' (human-readable)
  endTime         String                                           // '15:30 UTC'
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  // AI Note-Taker (Phase 1 / sPM-ai-notetaker). Minutes rendered as HTML
  // by GPT/Claude from the uploaded transcript + resolutions. The audio is
  // never stored (DPDPA stance) — only the transcript + the minutes.
  minutesHtml         String?
  minutesGeneratedAt  DateTime?
  minutesGeneratedBy  String?

  attendees       CrmAttendee[]
  resolutions    CrmResolution[]
  transcript     CrmMeetingTranscript?
  aiDraftNotes   CrmAiDraftNote[]

  @@map("crm_meetings")
  @@index([documentId])
}

model CrmAttendee {
  id          String    @id @default(uuid())
  meetingId   String
  userId      String
  roleInCrm   String                                                // Chair | Author | Reviewer | Observer
  joinedAt    DateTime?

  meeting     CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("crm_attendees")
  @@unique([meetingId, userId])
  @@index([meetingId])
}

model CrmResolution {
  id              String   @id @default(uuid())
  meetingId       String
  commentId       String                                            // FK to comments.id — human-readable CMT-###
  resolutionType  String                                            // accept | accept_with_modification | reject
  resolutionNote  String
  resolvedBy      String
  resolvedAt      DateTime @default(now())

  meeting         CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("crm_resolutions")
  @@unique([meetingId, commentId])                                  // one resolution per comment per meeting
  @@index([meetingId])
  @@index([commentId])
}

// --------------------------------------------------------------------------
// 6.4 crm_meeting_transcripts — raw transcript text uploaded post-meeting.
// Audio is NEVER stored (DPDPA retention stance — the audio was only an
// input to the transcription step). One transcript per meeting; replacing
// an existing transcript overwrites the row (chair re-ran transcription).
// --------------------------------------------------------------------------

model CrmMeetingTranscript {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  rawText     String                                              // the uploaded transcript, as-is
  wordCount   Int                                                 // cheap pre-computed for the UI
  source      String   @default("manual_paste")                   // 'manual_paste' | 'zoom_native' | 'teams_export' | 'bot' (Phase 3)
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  meeting     CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("crm_meeting_transcripts")
}

// --------------------------------------------------------------------------
// 6.5 crm_ai_draft_notes — AI-generated per-comment resolution-note drafts.
// Written when the chair uploads a transcript (one AI call extracts drafts
// for every open comment at once). The chair sees these pre-filled in the
// resolution composer and edits before saving the CrmResolution.
// Each regenerate call replaces the row for that (meetingId, commentId).
// --------------------------------------------------------------------------

model CrmAiDraftNote {
  id              String   @id @default(uuid())
  meetingId       String
  commentId       String
  draftText       String
  aiModel         String                                          // 'claude-3-5-sonnet-...' etc.
  aiCallRecordId  String?                                         // back-link to AiCallRecord for cost / audit
  generatedAt     DateTime @default(now())

  meeting         CrmMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("crm_ai_draft_notes")
  @@unique([meetingId, commentId])
  @@index([meetingId])
}

// --------------------------------------------------------------------------
// 7.1 voice_notes — audio notes attached to a document section
// --------------------------------------------------------------------------

model VoiceNote {
  id                   String    @id @default(uuid())
  documentId           String
  sectionRef           String
  authorId             String
  audioBlobKey         String                                          // key in BlobStorage 'voice' bucket
  audioRegion          String    @default("us-east-1")                   // GDPR data residency (FR NFR §8.3)
  transcript           String    @default("")
  transcriptStatus     String    @default("pending")                     // pending | complete | failed
  durationSeconds      Int?
  transcriptionEngine  String?                                           // claude-audio | whisper | google-stt
  insertedAt           DateTime?                                         // when transcript inserted into document
  createdAt            DateTime  @default(now())

  @@map("voice_notes")
  @@index([documentId])
  @@index([documentId, sectionRef])
}

// --------------------------------------------------------------------------
// document_uploads — pending uploads awaiting user confirmation
// --------------------------------------------------------------------------
//
// Flow:
//   POST /projects/:id/documents/upload → row with status='pending_classification'
//   POST /projects/:id/documents/confirm-classification → status='confirmed',
//     documentId linked to the new Document created in the same tx.
// Rejections (user cancels, virus scan fails) end up status='rejected' and
// are retained for compliance (never hard-deleted; retention cron handles
// eventual purge).

model DocumentUpload {
  id                   String   @id @default(uuid())
  projectId            String
  uploadedBy           String                                          // User.id
  blobKey              String                                          // key in the 'documents' BlobStorage bucket
  fileName             String
  fileSizeBytes        Int
  contentType          String
  virusScanStatus      String   @default("pending")                     // pending | passed | failed
  classification       Json?                                            // {documentType, typeConfidence, studyTitle, …}
  status               String   @default("pending_classification")      // pending_classification | confirmed | rejected
  documentId           String?                                          // set once /confirm-classification creates the Document
  rejectionReason      String?
  title                String?                                          // library title; defaults to the file name
  sourceCategory       String?                                          // protocol | sap | tlf | … | other (source-categories.ts)
  origin               String?                                          // free text: system / party it came from
  version              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("document_uploads")
  @@index([projectId])
  @@index([status])
  @@index([documentId])
}

// --------------------------------------------------------------------------
// 5.1 checklist_templates
// --------------------------------------------------------------------------

model ChecklistTemplate {
  id              String   @id @default(uuid())
  deliverableType String                                       // document_type
  // Null for the code-shipped platform baseline. Set to the owning project id
  // when an Admin creates a project-level override. One platform baseline +
  // many project overrides can coexist per deliverable type.
  projectId       String?
  version         Int      @default(1)
  effectiveDate   DateTime
  changeReason    String
  isCurrent       Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  // Lifecycle: a project-level override starts 'draft' while the Admin
  // customises it, and switches to 'locked' after approval. The platform
  // baseline is always 'locked' (ships with the code). Once a template is
  // locked, its items can't be reordered or added — Admin must bump a new
  // version (new row, next version number) to make further changes.
  templateStatus  String    @default("locked")              // 'draft' | 'locked'
  approvedBy      String?
  approvedAt      DateTime?

  items           ChecklistTemplateItem[]
  instances       ChecklistInstance[]

  @@map("checklist_templates")
  // Uniqueness widens to include projectId so each project's override
  // version-number sequence is independent of other projects + the baseline.
  @@unique([deliverableType, projectId, version])
  @@index([deliverableType])
  @@index([projectId])
}

model ChecklistTemplateItem {
  id                 String   @id @default(uuid())
  templateId         String
  text               String
  framework          String                                     // "ICH E3", "21 CFR Part 11", …
  frameworkMandatory Boolean  @default(true)
  // Which RACI role on the project team owns the tick. Any team member
  // whose membership carries this RACI letter can mark the item complete
  // on a document; the audit log records who did it. See docs/pivot-plan.md
  // for the full ownership model.
  ownerRaci          String   @default("R")                     // 'R' | 'A' | 'C' | 'I'
  // Which of the six document stages this item belongs to. The
  // submit-for-review / stage-advance / signature gates filter mandatory
  // items by stage so an item for CRM doesn't block Study Start-Up submit.
  // Values match DbStage: study_start_up, during_study, reporting,
  // cross_functional_review, crm, final_output.
  stage              String   @default("study_start_up")
  // Optional trigger that auto-completes this item on a real system event.
  // Null = manual tick only. Values: 'submit_for_review', 'crm_complete',
  // 'document_signed'. Auto-complete writes the same audit event as a
  // manual tick, with actorId = the user who triggered the event.
  autoCompleteOn     String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())

  template           ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  instanceItems      ChecklistInstanceItem[]

  @@map("checklist_template_items")
  @@index([templateId])
}

// --------------------------------------------------------------------------
// 5.3 checklist_instances
// --------------------------------------------------------------------------

model ChecklistInstance {
  id                 String   @id @default(uuid())
  documentId         String   @unique                           // one instance per document
  templateId         String
  templateVersion    Int
  notificationSentAt DateTime?
  createdAt          DateTime @default(now())

  document           Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  template           ChecklistTemplate       @relation(fields: [templateId], references: [id])
  items              ChecklistInstanceItem[]

  @@map("checklist_instances")
}

model ChecklistInstanceItem {
  id                 String    @id @default(uuid())
  instanceId         String
  templateItemId     String?                                    // null for user-added items
  text               String
  framework          String
  frameworkMandatory Boolean   @default(true)
  // Snapshotted from the template item at clone time so a later template
  // change can't retro-mutate an in-flight document (PRD rule). User-added
  // items default to R/study_start_up/null (the author decides).
  ownerRaci          String    @default("R")                    // 'R' | 'A' | 'C' | 'I'
  stage              String    @default("study_start_up")       // mirrors DbStage
  autoCompleteOn     String?                                    // mirrors ChecklistTemplateItem.autoCompleteOn
  status             String    @default("pending")              // checklist_item_status
  isUserAdded        Boolean   @default(false)
  completedBy        String?
  completedAt        DateTime?
  waivedBy           String?
  waivedAt           DateTime?
  waiverReason       String?                                    // required when status=waived
  sortOrder          Int       @default(0)

  instance           ChecklistInstance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateItem       ChecklistTemplateItem?  @relation(fields: [templateItemId], references: [id])

  @@map("checklist_instance_items")
  @@index([instanceId])
  @@index([instanceId, status])
}

// --------------------------------------------------------------------------
// 6.1 comments
// --------------------------------------------------------------------------

model Comment {
  id             String    @id                                   // "CMT-###" application-generated
  documentId     String
  sectionRef     String                                          // "§11.4.1"
  reviewerId     String
  text           String
  severity       String                                          // comment_severity — major | minor | query
  status         String    @default("open")                      // open | resolved
  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?

  // Reviewer verdict — Phase 2.2 of docs/pivot-plan.md Arc 5.
  // null = plain comment; non-null = reviewer action with the comment
  // body carrying the explanation. Three verdicts:
  //   'approve'          — approves the section as-is
  //   'request_changes'  — asks author to revise (soft return)
  //   'block_approval'   — hard block; CRM meeting cannot close until
  //                        this is resolved (chain-of-signature gate)
  // Chosen over a parallel ReviewAction entity per
  // docs/decisions/module-a-defaults.md §3.
  verdict        String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("comments")
  @@index([documentId])
  @@index([documentId, status])
  @@index([documentId, sectionRef])
  @@index([documentId, verdict])
}

// --------------------------------------------------------------------------
// 11b. ICH E3 section waivers — FR-A-026 § amber "waived" state.
// One row per (document, sectionCode) when a reviewer waives an ICH E3
// mandatory section (e.g. §16.4 Individual Patient Data Listings when the
// trial doesn't submit to the US). The validator endpoint joins the
// Document's section rows to these waivers to compute per-section status.
// Section codes are the ICH E3 shorthand (§1, §2, …, §16.3) kept as plain
// strings so the catalog can evolve without a schema migration.
// --------------------------------------------------------------------------

model IchSectionWaiver {
  id               String   @id @default(uuid())
  documentId       String
  sectionCode      String                                              // '§16.4', '§15', etc.
  waivedBy         String                                              // User.id
  waivedAt         DateTime @default(now())
  reason           String                                              // free-text, Part 11 trail
  versionAtWaiver  String                                              // DocumentVersion.versionNumber at waive time

  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ich_section_waivers")
  @@unique([documentId, sectionCode])
  @@index([documentId])
}

// --------------------------------------------------------------------------
// 12. TLF — Tables / Listings / Figures packages
// Source: 02-datamodel.md §12. One current package per project (soft
// invariant: isCurrent=true marks the live one); items are the T/L/F
// entries; section_links are the citations from doc sections.
// --------------------------------------------------------------------------

model TlfPackage {
  id            String    @id @default(uuid())
  projectId     String
  version       String                                              // 'v3'
  validatedBy   String                                              // User.id
  validatedAt   DateTime
  isCurrent     Boolean   @default(true)
  createdAt     DateTime  @default(now())

  items         TlfItem[]

  @@map("tlf_packages")
  @@unique([projectId, version])
  @@index([projectId])
  @@index([projectId, isCurrent])
}

model TlfItem {
  id            String    @id @default(uuid())
  packageId     String
  itemType      String                                              // 'T' | 'L' | 'F'
  referenceId   String                                              // 'Table 14.2.1'
  title         String
  sortOrder     Int       @default(0)

  package       TlfPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sectionLinks  TlfSectionLink[]

  @@map("tlf_items")
  @@unique([packageId, referenceId])
  @@index([packageId])
}

model TlfSectionLink {
  id              String    @id @default(uuid())
  tlfItemId       String
  documentId      String
  sectionRef      String                                            // '§11.4.1'
  referenceCount  Int       @default(1)

  tlfItem         TlfItem   @relation(fields: [tlfItemId], references: [id], onDelete: Cascade)

  @@map("tlf_section_links")
  @@unique([tlfItemId, documentId, sectionRef])
  @@index([tlfItemId])
  @@index([documentId, sectionRef])
}

// --------------------------------------------------------------------------
// 9. E-Signatures — Part 11 chain + per-signer records
// Source: 02-datamodel.md §9, docs/compliance/Part11/compliance-assessment.md.
//
// Compliance decisions baked in (defaults, revisit when Compliance signs off):
//   - §11.70 artefact bound to canonical JSON hash (hashSections() of
//     DocumentVersion content; see service.ts). Deterministic + machine-
//     verifiable. If Compliance later wants PDF binding, we add a second
//     hash column, not swap this one.
//   - §11.200 two-component: password re-auth + TOTP per signature.
//     credentialHash is sha256 of the auth proof — never plaintext.
//   - Signed records are IMMUTABLE at the app layer (routes refuse update).
//     DB trigger lifting deferred to Phase 2 per datamodel §9.2 notes.
// --------------------------------------------------------------------------

model SignatureChain {
  id              String    @id @default(uuid())
  documentId      String
  chainType       String    @default("sequential")                   // sequential | parallel
  status          String    @default("initiated")                    // initiated | in_progress | complete | cancelled
  initiatedBy     String
  initiatedAt     DateTime  @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  records         SignatureRecord[]

  @@map("signature_chains")
  @@index([documentId])
  @@index([status])
}

model SignatureRecord {
  id                String    @id                                    // 'SIG-####-##' app-generated
  chainId           String
  signerId          String
  signerName        String                                           // denormalised
  signerRole        String                                           // denormalised
  step              Int
  meaning           String                                           // authored | reviewed | approved
  status            String    @default("queued")                     // queued | awaiting | signed
  scopeSections     String[]  @default([])                           // empty = whole doc
  documentHash      String?                                          // sha256 bound at sign time (§11.70)
  versionAtSigning  String?                                          // 'v0.4'
  credentialHash    String?                                          // sha256(password proof); never plaintext
  timestampUtc      DateTime?                                        // set on signing
  localTime         String?                                          // '16:32 CET'
  timeSource        String?                                          // 'Aurora time server, NTP stratum 2'
  authMethod        String?                                          // 'password re-auth + TOTP'
  deviceInfo        String?
  networkInfo       String?

  chain             SignatureChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@map("signature_records")
  @@unique([chainId, step])
  @@index([chainId])
  @@index([signerId])
}

// --------------------------------------------------------------------------
// §10 Presence sessions — section-level "who's editing what right now"
// Source: 02-datamodel.md §10. REST-polling layer shipped now; Socket.io
// push + Redis pub/sub for cross-instance fanout is a follow-up.
//
// Lifecycle:
//   POST   /documents/:id/presence              → create 'active' session
//   PATCH  /documents/:id/presence/:sid/heartbeat → bump heartbeatAt
//   DELETE /documents/:id/presence/:sid         → set endedAt (soft-close)
//
// A nightly reaper closes rows whose heartbeatAt is older than
// PRESENCE_STALE_SECONDS (default 90s) — matches the client polling interval.
// Once Socket.io ships, 'ended' can be set on disconnect instantly.
// --------------------------------------------------------------------------

model PresenceSession {
  id             String    @id @default(uuid())
  documentId     String
  userId         String
  sectionId      String
  status         String    @default("active")                         // active | idle | ended
  startedAt      DateTime  @default(now())
  heartbeatAt    DateTime  @default(now())
  endedAt        DateTime?

  @@map("presence_sessions")
  @@index([documentId])
  @@index([documentId, status])
  @@index([userId])
  // No UNIQUE(documentId, userId, sectionId) — multiple tabs are allowed;
  // the reaper closes stale duplicates. The 'who's here' aggregate query
  // dedupes by (userId, sectionId) at read time.
}

// --------------------------------------------------------------------------
// 4.N section_locks — advisory lock while a writer actively edits a section
// (autosave flow; sPM-autosave). Exactly one holder per (documentId, sectionId)
// at a time, enforced by UNIQUE. The lock is lease-based: the client renews
// via heartbeat every HEARTBEAT_INTERVAL seconds and the lock is considered
// dead when lastHeartbeatAt is older than SECTION_LOCK_STALE_SECONDS
// (default 90s). A fresh acquire from another user succeeds when the current
// lock is dead; from the same user, it extends the existing lease (so a
// page refresh never locks the writer out of their own section).
//
// Endpoints:
//   POST   /documents/:docId/sections/:secId/lock   → acquire | extend
//   DELETE /documents/:docId/sections/:secId/lock   → explicit release
//
// PATCH /sections/:secId checks this table and returns 423 Locked when
// a different user holds a live lock. No lease = no write.
// --------------------------------------------------------------------------

model SectionLock {
  id                String   @id @default(uuid())
  documentId        String
  sectionId         String
  userId            String
  acquiredAt        DateTime @default(now())
  lastHeartbeatAt   DateTime @default(now())

  @@map("section_locks")
  @@unique([documentId, sectionId])
  @@index([userId])
  @@index([lastHeartbeatAt])
}
