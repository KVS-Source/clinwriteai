// Module B — Scientific Writing models.
//
// Source: docs/demo/02-datamodel.md §18-§23 (publications, citations, authors
// + ICMJE, submission readiness, peer review). Enum columns are TEXT with
// Zod validation at the route edge, same convention as Module A.
//
// What's HERE:
//   - publications, ai_footprint_spans
//   - citations (soft-deleted via removedAt; Vancouver labels computed on read)
//   - publication_authors + pub_icmje_criteria + pub_icmje_acknowledgements
//   - debarment_check_runs
//   - submission_checks
//   - peer_review_rounds (scaffold — the comments table lands next session)
//
// What's NOT here yet (ships in later Module B sessions):
//   - congress_submissions (OQ-B-004 — no live portal API)
//   - peer_review_comments (needs reviewer-blind workflow)
//   - portfolio + master_library (admin-only, Phase 4 overlap)
//   - PubMed / CrossRef / ORCID connectors (external procurement — see memory)

model Publication {
  id                   String    @id @default(uuid())
  projectId            String
  type                 String                                       // publication_type
  subtype              String?                                      // manuscript_subtype (non-null when type=manuscript)
  title                String
  stage                String    @default("planning")                // publication_stage
  status               String    @default("not_started")             // publication_status
  version              String    @default("v0.1")
  guideline            String                                       // equator_guideline (CONSORT, STROBE, …)
  journal              String?
  targetSubmissionDate DateTime?
  keyMessage           String?
  baaStatus            String    @default("not_applicable")          // baa_status (FR-B-025 case_report)

  // Cross-module link to the Module A CSR (OQ-B-001). Nullable because
  // not every publication starts from a CSR (editorials, PLSs can originate
  // from external source material).
  sourceDocumentId     String?
  sourceDocumentLabel  String?                                      // denormalised at link time

  ownerId              String
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // ---- Versioning pin (migration 76, Phase M-B.2) ----
  // Points to the PublicationVersion that is 'isCurrent=true' for this
  // publication. Analogue of Document.currentVersionId. Null during
  // the brief window between Publication.create and the v0.1 insert in
  // the same transaction.
  currentVersionId     String?   @unique @map("current_version_id")
  currentVersion       PublicationVersion? @relation("PublicationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions             PublicationVersion[] @relation("PublicationVersions")

  // ---- Policy pins (migration 75, Phase M-B.1) ----
  // Mirror of Module A Document's policyVersionAtCreate /
  // aiPromptRecordId / bestPracticeRecordId pins. Captured when the
  // publication is created so later admin approvals of newer
  // AiPromptRecord / BestPracticeRecord versions don't retroactively
  // change what AI sees for this manuscript. The resolver (built in
  // Phase M-B.4) falls back to the current approved record when these
  // are null — same shape as clinical writing.
  pubTypePolicyVersionAtCreate Int?      @map("pub_type_policy_version_at_create")
  publicationAiPromptRecordId  String?   @map("publication_ai_prompt_record_id")
  publicationAiPromptVersionAtCreate Int? @map("publication_ai_prompt_version_at_create")
  publicationBestPracticeRecordId        String?  @map("publication_best_practice_record_id")
  publicationBestPracticeVersionAtCreate Int?     @map("publication_best_practice_version_at_create")

  // ---- AI drafter state (migration 77, Phase M-B.3) ----
  // Mirror of Document.aiDraftState. Lifecycle:
  //   'idle'       — no AI draft in progress; the publication was created
  //                  but no author has triggered the initial draft.
  //   'drafting'   — publications.ai_initial_draft is actively drafting
  //                  sections against the attached source material.
  //   'validating' — the drafter has committed sections and the
  //                  validation-pass loop is iterating toward the 85 %
  //                  confidence target (see MIN_ITERATIONS / MAX_ITERATIONS
  //                  in publications.ai_validation_pass).
  //   'complete'   — chain finished. Either confidence hit 85 % or the
  //                  iteration cap triggered; residual failing sections
  //                  are surfaced via aiFlags on PublicationSectionContent.
  aiDraftState         String    @default("idle")  @map("ai_draft_state")
  // Author-provided directives that flow into every AI call for this
  // publication (tone, language, structure hints). Mirrors
  // Document.aiInstructions. Max 2000 chars enforced at the route edge.
  aiInstructions       String?   @map("ai_instructions")

  aiFootprintSpans     AiFootprintSpan[]
  citations            Citation[]
  authors              PublicationAuthor[]
  debarmentChecks      DebarmentCheckRun[]
  submissionChecks     SubmissionCheck[]
  reviewRounds         PeerReviewRound[]
  congressSubmissions  CongressSubmission[]
  slideDeckJobs        SlideDeckJob[]

  @@map("publications")
  @@index([projectId])
  @@index([stage])
  @@index([status])
  @@index([type])
  @@index([sourceDocumentId])
}

// --------------------------------------------------------------------------
// 18.2 ai_footprint_spans — immutable AI provenance (FR-B-009)
// --------------------------------------------------------------------------

model AiFootprintSpan {
  id             String   @id @default(uuid())
  publicationId  String
  sectionId      String                                             // 'methods' | 'results' | 'discussion' | …
  startOffset    Int
  endOffset      Int
  // charCount lives as a derived read in the service layer rather than as a
  // Postgres GENERATED column — Prisma can't express that constraint, and
  // the trade-off (one less column vs. an extra 10 lines of code) is tiny.
  model          String                                             // 'claude-sonnet-4-6' etc.
  generatedAt    DateTime
  acceptedBy     String
  acceptedAt     DateTime @default(now())

  publication    Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("ai_footprint_spans")
  @@index([publicationId])
  @@index([publicationId, sectionId])
}

// --------------------------------------------------------------------------
// publication_section_totals — denominator for the AI footprint %age.
//
// The manuscript editor reports per-section total char counts here (PUT
// /publications/:id/section-totals). GET /:id/footprint uses these totals
// to compute real percentages; if no totals are recorded for a section
// yet, the route falls back to the historical "100% if any AI" approx.
// --------------------------------------------------------------------------

model PublicationSectionTotal {
  id             String   @id @default(uuid())
  publicationId  String
  sectionId      String                                             // matches AiFootprintSpan.sectionId
  totalChars     Int                                                // from the editor
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("publication_section_totals")
  @@unique([publicationId, sectionId])
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 19.1 citations — soft-delete; Vancouver labels computed on read
// --------------------------------------------------------------------------

model Citation {
  id                String    @id @default(uuid())
  publicationId     String
  pmid              String?                                         // null for project source documents
  title             String
  shortRef          String                                          // 'Gandhi L et al., NEJM 2018'
  fullRef           String                                          // full Vancouver-formatted
  locus             String                                          // '§Results ¶1'
  isSourceDocument  Boolean   @default(false)                        // true = CSR citation, cannot soft-remove
  insertedBy        String
  insertedAt        DateTime  @default(now())
  removedBy         String?
  removedAt         DateTime?

  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("citations")
  @@index([publicationId])
  @@index([pmid])
}

// --------------------------------------------------------------------------
// 20.1 publication_authors
// --------------------------------------------------------------------------

model PublicationAuthor {
  id                   String    @id @default(uuid())
  publicationId        String
  userId               String?                                      // null for external KOLs
  name                 String                                       // denormalised (externals have no User row)
  initials             String
  role                 String                                       // 'Medical writer / publication lead'
  raci                 String                                       // raci_role
  isExternal           Boolean   @default(false)
  coiStatus            String    @default("pending")                 // pending | submitted
  coiSubmittedAt       DateTime?
  debarmentStatus      String    @default("unchecked")               // unchecked | clear | flagged
  debarmentCheckedAt   DateTime?
  invitedAt            DateTime?
  inviteEmail          String?                                      // for external KOLs
  addedBy              String
  addedAt              DateTime  @default(now())
  removedAt            DateTime?

  publication          Publication                   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  icmjeCriteria        PubIcmjeCriterion[]
  icmjeAcknowledgements PubIcmjeAcknowledgement[]

  @@map("publication_authors")
  @@unique([publicationId, userId])                                 // one role per user per publication
  @@index([publicationId])
  @@index([userId])
}

// --------------------------------------------------------------------------
// 20.2 pub_icmje_criteria — exactly 4 rows per author (indices 0-3)
// --------------------------------------------------------------------------

model PubIcmjeCriterion {
  id              String    @id @default(uuid())
  authorId        String
  criterionIndex  Int                                               // 0..3
  met             Boolean   @default(false)
  confirmedBy     String?
  confirmedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  author          PublicationAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("pub_icmje_criteria")
  @@unique([authorId, criterionIndex])
  @@index([authorId])
}

// --------------------------------------------------------------------------
// 20.3 pub_icmje_acknowledgements — OQ-B-003 soft-gate override log
// --------------------------------------------------------------------------

model PubIcmjeAcknowledgement {
  id              String   @id @default(uuid())
  authorId        String
  acknowledgedBy  String
  acknowledgedAt  DateTime @default(now())
  missingCriteria Int[]                                             // e.g. [2, 3]

  author          PublicationAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("pub_icmje_acknowledgements")
  @@unique([authorId, acknowledgedAt])
  @@index([authorId])
}

// --------------------------------------------------------------------------
// 20.4 debarment_check_runs — FR-B-016
// --------------------------------------------------------------------------

model DebarmentCheckRun {
  id              String   @id @default(uuid())
  publicationId   String
  runBy           String
  runAt           DateTime @default(now())
  authorsChecked  Int
  matchesFound    Int      @default(0)
  sourcesQueried  String[] @default(["FDA debarment list", "OIG exclusions"])
  results         Json                                              // [{authorId, authorName, status}]

  publication     Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("debarment_check_runs")
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 21.1 submission_checks — persisted so acknowledgements survive reload
// --------------------------------------------------------------------------

model SubmissionCheck {
  id              String    @id @default(uuid())
  publicationId   String
  groupId         String                                            // format|words|equator|figures|statements|plagiarism|refs
  label           String
  state           String    @default("pass")                         // check_state — pass|warn|ack|block|fail
  note            String    @default("")
  lastRunAt       DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?

  publication     Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("submission_checks")
  @@unique([publicationId, groupId, label])
  @@index([publicationId])
  @@index([publicationId, state])
}

// --------------------------------------------------------------------------
// 22.1 congress_submissions — one row per congress export per publication
// (OQ-B-004: no live portal API; status transitions are manual flags).
// --------------------------------------------------------------------------

model CongressSubmission {
  id                 String    @id @default(uuid())
  publicationId      String
  congressId         String                                          // congress_id enum (ESMO, ASCO, …)
  congressName       String                                          // denormalised snapshot
  characterLimit     Int
  keywordsRequired   Int
  keywordsEntered    Int       @default(0)
  deadline           DateTime  @db.Date
  portalUrl          String
  characterCount     Int       @default(0)                            // computed from content at export time; frozen on this record
  status             String    @default("draft")                      // draft | exported | submitted | accepted | rejected
  exportedAt         DateTime?
  exportedBy         String?
  createdAt          DateTime  @default(now())

  publication        Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("congress_submissions")
  @@index([publicationId])
  @@index([publicationId, status])
}

// --------------------------------------------------------------------------
// 23.1 peer_review_rounds
// --------------------------------------------------------------------------

model PeerReviewRound {
  id                     String   @id @default(uuid())
  publicationId          String
  roundNumber            Int      @default(1)
  journalSubmissionRef   String                                     // e.g. 'NEJM-2026-28471'
  reviewerCount          Int      @default(3)
  submittedAt            DateTime?                                   // response letter submitted — round locked
  createdAt              DateTime @default(now())

  publication            Publication                @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  comments               ReviewerComment[]
  letterVersions         ResponseLetterVersion[]

  @@map("peer_review_rounds")
  @@unique([publicationId, roundNumber])
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 23.2 reviewer_comments — one row per reviewer or editor comment
// --------------------------------------------------------------------------

model ReviewerComment {
  id                   String    @id @default(uuid())
  roundId              String
  reviewerTab          String                                          // r1 | r2 | r3 | ed
  commentNumber        Int                                             // 1-based within reviewerTab
  commentText          String
  responseText         String    @default("")
  status               String    @default("not_started")                // not_started | drafting | responded
  // AI provenance when the response was AI-drafted + accepted. Match
  // the Part 11 shape in Module A ProvenanceRecord.
  aiDrafted            Boolean   @default(false)
  aiModel              String?
  aiGeneratedAt        DateTime?
  aiAcceptedBy         String?
  aiAcceptedAt         DateTime?
  respondedBy          String?
  respondedAt          DateTime?

  round                PeerReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("reviewer_comments")
  @@unique([roundId, reviewerTab, commentNumber])
  @@index([roundId])
  @@index([roundId, status])
}

// --------------------------------------------------------------------------
// 23.3 response_letter_versions — immutable snapshot per save
// --------------------------------------------------------------------------

model ResponseLetterVersion {
  id              String   @id @default(uuid())
  roundId         String
  letterVersion   String                                              // 'v1.N' — N = responded_count
  respondedCount  Int
  totalCount      Int
  contentHash     String                                              // sha256 of the assembled letter text
  createdBy       String
  createdAt       DateTime @default(now())

  round           PeerReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("response_letter_versions")
  @@index([roundId])
}


// --------------------------------------------------------------------------
// Slide deck backend (sPM-slide-deck-backend)
// First real backing for the SlidedeckGenerator UI. One SlideDeckJob per
// generation run (status flows draft → generating → ready → exported).
// Content fields are plain prose (not HTML) — the UI edits in textareas.
// Edit history uses the polymorphic EditHistory table with
// entityType='slide' + entityId=slide.id + beforeHtml/afterHtml as JSON
// payload (title + bodyText + speakerNotes serialised together).
// --------------------------------------------------------------------------

model SlideDeckJob {
  id                String   @id @default(uuid())
  publicationId     String
  source            String   @default("full-manuscript")
  congressTarget    String?
  slideCountLimit   Int      @default(20)
  status            String   @default("draft")                    // draft|generating|ready|exported
  aiModel           String   @default("claude-sonnet-4-6")
  aiFootprintPct    Int      @default(0)
  generatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  slides            Slide[]

  @@map("slide_deck_jobs")
  @@index([publicationId])
}

model Slide {
  id              String   @id @default(uuid())
  slideDeckJobId  String
  position        Int
  title           String   @default("")
  bodyText        String   @default("")
  speakerNotes    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slideDeckJob    SlideDeckJob @relation(fields: [slideDeckJobId], references: [id], onDelete: Cascade)
  figures         SlideFigure[]

  @@map("slides")
  @@index([slideDeckJobId, position])
}

model SlideFigure {
  id                String   @id @default(uuid())
  slideId           String
  figureRef         String
  altText           String?
  figureDescription String?

  slide             Slide    @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@map("slide_figures")
  @@index([slideId])
}

// --------------------------------------------------------------------------
// journals — target-journal catalogue for JournalSubmissionReadiness.
//
// Static reference data (impact factor, acceptance rate, time-to-decision,
// ICMJE/EQUATOR flags). Seeded from the fixture that used to live inline in
// JournalSubmissionReadiness.tsx. Not tenant-scoped — the catalogue is a
// platform-wide reference set. Scope is a free-text tag (e.g. "oncology")
// used for coarse filtering; a richer taxonomy is deferred.
// --------------------------------------------------------------------------

model Journal {
  id                       String   @id @default(uuid())
  name                     String
  abbreviation             String
  impactFactor             Float?
  acceptanceRate           Float?                                         // 0.0..1.0
  timeToDecision           Int?                                           // median days to first decision
  isICMJE                  Boolean  @default(false)
  isEQUATOR                Boolean  @default(false)
  scope                    String?                                        // free-text tag, e.g. "oncology"
  submissionGuidelinesUrl  String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("journals")
  @@index([scope])
  @@index([isICMJE])
}

// --------------------------------------------------------------------------
// Publication Policies — Phase M-B.1 (migration 75).
//
// Mirror of Module A's pointer-refactor architecture
// (DocumentTypePolicy + AiPromptRecord + BestPracticeRecord). Keeps
// Module A and B independently evolvable. Policy types use flat slugs
// per subtype decision: 'manuscript_full_research',
// 'manuscript_review_systematic', 'manuscript_review_narrative',
// 'manuscript_case_report', 'abstract', 'poster', 'letter', 'pls'.
// --------------------------------------------------------------------------

model PublicationTypePolicy {
  id                       String    @id @default(uuid())
  docType                  String                                           // flat slug — see header
  version                  Int                                              // 1-based, unique per docType
  isCurrent                Boolean   @default(true)                         // flipped on bump + retire

  // Pins to the three asset tables. Nullable when no asset is wired yet.
  templateId               String?                                          // PublicationTemplate.id (pin override)
  checklistTemplateId      String?                                          // PublicationChecklistTemplate.id (pin override)
  guidelineKey             String?                                          // CONSORT | STROBE | PRISMA | MOOSE | ICMJE_RECOMMENDATIONS | …

  // Legacy mirror fields — same role as DocumentTypePolicy.smePrompt /
  // bestPracticeDigest / sectionRules: fallback for documents created
  // before any approved AiPromptRecord / BestPracticeRecord for this
  // docType exists. Dropped in Phase 3 of the pointer refactor once
  // readers have migrated.
  smePrompt                String    @default("")
  bestPracticeDigest       Json      @default("{\"principles\":[]}")
  sectionRules             Json      @default("{}")

  effectiveDate            DateTime  @default(now())
  retiredAt                DateTime?
  retiredBy                String?
  retireReason             String?
  supersededBy             String?

  createdBy                String
  updatedBy                String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("publication_type_policies")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model PublicationAiPromptRecord {
  id             String    @id @default(uuid())
  docType        String                                                    // same slugs as PublicationTypePolicy
  version        Int                                                       // 1-based, unique per docType
  status         String    @default("draft")                               // 'draft' | 'approved' | 'retired'

  smePrompt      String
  sectionRules   Json      @default("{}")                                  // { <sectionKey>: [{severity, text}] }

  supersededBy   String?
  effectiveDate  DateTime?
  retiredAt      DateTime?
  retireReason   String?
  approvedBy     String?
  approvedAt     DateTime?

  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("publication_ai_prompt_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model PublicationBestPracticeRecord {
  id             String    @id @default(uuid())
  docType        String                                                    // same slugs as PublicationTypePolicy
  version        Int                                                       // 1-based, unique per docType
  status         String    @default("draft")                               // 'draft' | 'approved' | 'retired'

  digest         Json      @default("{\"principles\":[]}")                 // { principles: [{ scope, severity, text }] }
  sourcePdfId    String?                                                   // DocumentUpload.id that produced this digest
  distilledAt    DateTime?
  distilledModel String?

  supersededBy   String?
  effectiveDate  DateTime?
  retiredAt      DateTime?
  retireReason   String?
  approvedBy     String?
  approvedAt     DateTime?

  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("publication_best_practice_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model PublicationTemplate {
  id             String    @id @default(uuid())
  docType        String                                                    // same slugs as PublicationTypePolicy
  version        Int       @default(1)
  isCurrent      Boolean   @default(true)
  label          String
  description    String    @default("")

  // sections: Array<{ id, number, title, instructions?, guidance?,
  //                   requiredMinChars?, journalHint? }>
  // id is the stable section key stored on PublicationSectionContent
  // once Phase M-B.2 lands.
  sections       Json      @default("[]")

  retiredAt      DateTime?
  retiredBy      String?

  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("publication_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model PublicationChecklistTemplate {
  id             String    @id @default(uuid())
  docType        String                                                    // same slugs
  version        Int       @default(1)
  isCurrent      Boolean   @default(true)

  // items: Array<{ id, label, required, groupId, helpText? }>
  // groupId matches SubmissionCheck group vocab (format / words /
  // equator / figures / statements / plagiarism / refs) so UI can
  // render consistent columns.
  items          Json      @default("[]")

  retiredAt      DateTime?
  retiredBy      String?

  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("publication_checklist_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

// --------------------------------------------------------------------------
// Publication versioning — Phase M-B.2 (migration 76).
//
// Mirror of Module A's DocumentVersion + SectionContent + SectionLock
// with no cross-module coupling. Publication.currentVersionId points
// to the row that's isCurrent=true. Bumping a new version flips the
// previous one's isCurrent to false in the same transaction.
//
// PublicationSectionContent carries aiFlags + aiConfidence so the
// validation-pass worker (Phase M-B.3) can score each section with the
// same 85% rubric used in clinical writing.
// --------------------------------------------------------------------------

model PublicationVersion {
  id              String   @id @default(uuid())
  publicationId   String
  versionNumber   String                                                   // "v0.1", "v0.2", …
  label           String                                                   // "Draft" | "For Review" | "Final"
  contentHash     String                                                   // sha256 of all sections — audit chain
  isCurrent       Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  // Carries {fromVersionId, sections[], reason} when this version came
  // from a restore operation. Null for normal bumps.
  restoreSource   Json?

  publication     Publication                 @relation("PublicationVersions", fields: [publicationId], references: [id], onDelete: Cascade)
  sections        PublicationSectionContent[]
  currentOf       Publication?                @relation("PublicationCurrentVersion")

  @@map("publication_versions")
  @@unique([publicationId, versionNumber])
  @@index([publicationId])
}

model PublicationSectionContent {
  id                     String   @id @default(uuid())
  publicationVersionId   String
  sectionId              String                                            // 'methods', 'results', 's3_2_results', …
  sectionNumber          String                                            // Vancouver-style or free-text ("1", "2.1")
  sectionTitle           String
  contentHtml            String   @default("")
  wordCount              Int      @default(0)
  aiSpanCount            Int      @default(0)
  humanSpanCount         Int      @default(0)
  lastEditedBy           String?
  lastEditedAt           DateTime?

  // AI confidence (0-100) computed by the ai_validation_pass worker
  // using the same rubric as Module A's SectionContent. Null until the
  // first validation pass evaluates this section.
  aiConfidence           Int?       @map("ai_confidence")
  aiFlags                String[]   @default([]) @map("ai_flags")

  version                PublicationVersion @relation(fields: [publicationVersionId], references: [id], onDelete: Cascade)

  @@map("publication_section_contents")
  @@unique([publicationVersionId, sectionId])
  @@index([publicationVersionId])
}

model PublicationSectionLock {
  id                String   @id @default(uuid())
  publicationId     String
  sectionId         String
  userId            String
  acquiredAt        DateTime @default(now())
  lastHeartbeatAt   DateTime @default(now())

  @@map("publication_section_locks")
  @@unique([publicationId, sectionId])
  @@index([userId])
  @@index([lastHeartbeatAt])
}

// --------------------------------------------------------------------------
// PublicationSectionComment — Phase M-B.5 (migration 78).
//
// Threaded comments per publication section. Mirror of Module A's
// Comment model but scoped to publications (no entityType reuse — the
// clinical Comment carries document-specific columns like `verdict`
// and `externalEmail` that don't apply here).
//
// Role gates (enforced at the route edge):
//   - R, A, C authors can create comments
//   - I authors are read-only
//   - PM / admin can read everything, create comments
//   - Only the comment author or R/A can resolve
//
// mentionedUserIds fires 'publication.comment_mention' notifications
// at create time (same shape as clinical comment.mention).
// --------------------------------------------------------------------------

model PublicationSectionComment {
  id                String    @id @default(uuid())
  publicationId     String
  sectionId         String                                                 // stable section key
  authorId          String                                                 // User.id of the commenter
  authorName        String                                                 // denormalised at create time (externals have no User row)
  text              String
  severity          String    @default("info")                             // 'info' | 'warning' | 'blocking'
  status            String    @default("open")                             // 'open' | 'resolved'
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNote    String?
  parentCommentId   String?                                                // optional thread parent (self-reference)
  mentionedUserIds  String[]  @default([])                                 // notification fan-out at create
  createdAt         DateTime  @default(now())

  @@map("publication_section_comments")
  @@index([publicationId])
  @@index([publicationId, sectionId])
  @@index([parentCommentId])
}
