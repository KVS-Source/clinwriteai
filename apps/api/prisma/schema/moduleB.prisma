// Module B — Scientific Writing models.
//
// Source: docs/demo/02-datamodel.md §18-§23 (publications, citations, authors
// + ICMJE, submission readiness, peer review). Enum columns are TEXT with
// Zod validation at the route edge, same convention as Module A.
//
// What's HERE:
//   - publications, ai_footprint_spans
//   - citations (soft-deleted via removedAt; Vancouver labels computed on read)
//   - publication_authors + pub_icmje_criteria + pub_icmje_acknowledgements
//   - debarment_check_runs
//   - submission_checks
//   - peer_review_rounds (scaffold — the comments table lands next session)
//
// What's NOT here yet (ships in later Module B sessions):
//   - congress_submissions (OQ-B-004 — no live portal API)
//   - peer_review_comments (needs reviewer-blind workflow)
//   - portfolio + master_library (admin-only, Phase 4 overlap)
//   - PubMed / CrossRef / ORCID connectors (external procurement — see memory)

model Publication {
  id                   String    @id @default(uuid())
  projectId            String
  type                 String                                       // publication_type
  subtype              String?                                      // manuscript_subtype (non-null when type=manuscript)
  title                String
  stage                String    @default("planning")                // publication_stage
  status               String    @default("not_started")             // publication_status
  version              String    @default("v0.1")
  guideline            String                                       // equator_guideline (CONSORT, STROBE, …)
  journal              String?
  targetSubmissionDate DateTime?
  keyMessage           String?
  baaStatus            String    @default("not_applicable")          // baa_status (FR-B-025 case_report)

  // Cross-module link to the Module A CSR (OQ-B-001). Nullable because
  // not every publication starts from a CSR (editorials, PLSs can originate
  // from external source material).
  sourceDocumentId     String?
  sourceDocumentLabel  String?                                      // denormalised at link time

  ownerId              String
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  aiFootprintSpans     AiFootprintSpan[]
  citations            Citation[]
  authors              PublicationAuthor[]
  debarmentChecks      DebarmentCheckRun[]
  submissionChecks     SubmissionCheck[]
  reviewRounds         PeerReviewRound[]
  congressSubmissions  CongressSubmission[]

  @@map("publications")
  @@index([projectId])
  @@index([stage])
  @@index([status])
  @@index([type])
  @@index([sourceDocumentId])
}

// --------------------------------------------------------------------------
// 18.2 ai_footprint_spans — immutable AI provenance (FR-B-009)
// --------------------------------------------------------------------------

model AiFootprintSpan {
  id             String   @id @default(uuid())
  publicationId  String
  sectionId      String                                             // 'methods' | 'results' | 'discussion' | …
  startOffset    Int
  endOffset      Int
  // charCount lives as a derived read in the service layer rather than as a
  // Postgres GENERATED column — Prisma can't express that constraint, and
  // the trade-off (one less column vs. an extra 10 lines of code) is tiny.
  model          String                                             // 'claude-sonnet-4-6' etc.
  generatedAt    DateTime
  acceptedBy     String
  acceptedAt     DateTime @default(now())

  publication    Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("ai_footprint_spans")
  @@index([publicationId])
  @@index([publicationId, sectionId])
}

// --------------------------------------------------------------------------
// publication_section_totals — denominator for the AI footprint %age.
//
// The manuscript editor reports per-section total char counts here (PUT
// /publications/:id/section-totals). GET /:id/footprint uses these totals
// to compute real percentages; if no totals are recorded for a section
// yet, the route falls back to the historical "100% if any AI" approx.
// --------------------------------------------------------------------------

model PublicationSectionTotal {
  id             String   @id @default(uuid())
  publicationId  String
  sectionId      String                                             // matches AiFootprintSpan.sectionId
  totalChars     Int                                                // from the editor
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("publication_section_totals")
  @@unique([publicationId, sectionId])
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 19.1 citations — soft-delete; Vancouver labels computed on read
// --------------------------------------------------------------------------

model Citation {
  id                String    @id @default(uuid())
  publicationId     String
  pmid              String?                                         // null for project source documents
  title             String
  shortRef          String                                          // 'Gandhi L et al., NEJM 2018'
  fullRef           String                                          // full Vancouver-formatted
  locus             String                                          // '§Results ¶1'
  isSourceDocument  Boolean   @default(false)                        // true = CSR citation, cannot soft-remove
  insertedBy        String
  insertedAt        DateTime  @default(now())
  removedBy         String?
  removedAt         DateTime?

  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("citations")
  @@index([publicationId])
  @@index([pmid])
}

// --------------------------------------------------------------------------
// 20.1 publication_authors
// --------------------------------------------------------------------------

model PublicationAuthor {
  id                   String    @id @default(uuid())
  publicationId        String
  userId               String?                                      // null for external KOLs
  name                 String                                       // denormalised (externals have no User row)
  initials             String
  role                 String                                       // 'Medical writer / publication lead'
  raci                 String                                       // raci_role
  isExternal           Boolean   @default(false)
  coiStatus            String    @default("pending")                 // pending | submitted
  coiSubmittedAt       DateTime?
  debarmentStatus      String    @default("unchecked")               // unchecked | clear | flagged
  debarmentCheckedAt   DateTime?
  invitedAt            DateTime?
  inviteEmail          String?                                      // for external KOLs
  addedBy              String
  addedAt              DateTime  @default(now())
  removedAt            DateTime?

  publication          Publication                   @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  icmjeCriteria        PubIcmjeCriterion[]
  icmjeAcknowledgements PubIcmjeAcknowledgement[]

  @@map("publication_authors")
  @@unique([publicationId, userId])                                 // one role per user per publication
  @@index([publicationId])
  @@index([userId])
}

// --------------------------------------------------------------------------
// 20.2 pub_icmje_criteria — exactly 4 rows per author (indices 0-3)
// --------------------------------------------------------------------------

model PubIcmjeCriterion {
  id              String    @id @default(uuid())
  authorId        String
  criterionIndex  Int                                               // 0..3
  met             Boolean   @default(false)
  confirmedBy     String?
  confirmedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  author          PublicationAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("pub_icmje_criteria")
  @@unique([authorId, criterionIndex])
  @@index([authorId])
}

// --------------------------------------------------------------------------
// 20.3 pub_icmje_acknowledgements — OQ-B-003 soft-gate override log
// --------------------------------------------------------------------------

model PubIcmjeAcknowledgement {
  id              String   @id @default(uuid())
  authorId        String
  acknowledgedBy  String
  acknowledgedAt  DateTime @default(now())
  missingCriteria Int[]                                             // e.g. [2, 3]

  author          PublicationAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("pub_icmje_acknowledgements")
  @@unique([authorId, acknowledgedAt])
  @@index([authorId])
}

// --------------------------------------------------------------------------
// 20.4 debarment_check_runs — FR-B-016
// --------------------------------------------------------------------------

model DebarmentCheckRun {
  id              String   @id @default(uuid())
  publicationId   String
  runBy           String
  runAt           DateTime @default(now())
  authorsChecked  Int
  matchesFound    Int      @default(0)
  sourcesQueried  String[] @default(["FDA debarment list", "OIG exclusions"])
  results         Json                                              // [{authorId, authorName, status}]

  publication     Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("debarment_check_runs")
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 21.1 submission_checks — persisted so acknowledgements survive reload
// --------------------------------------------------------------------------

model SubmissionCheck {
  id              String    @id @default(uuid())
  publicationId   String
  groupId         String                                            // format|words|equator|figures|statements|plagiarism|refs
  label           String
  state           String    @default("pass")                         // check_state — pass|warn|ack|block|fail
  note            String    @default("")
  lastRunAt       DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?

  publication     Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("submission_checks")
  @@unique([publicationId, groupId, label])
  @@index([publicationId])
  @@index([publicationId, state])
}

// --------------------------------------------------------------------------
// 22.1 congress_submissions — one row per congress export per publication
// (OQ-B-004: no live portal API; status transitions are manual flags).
// --------------------------------------------------------------------------

model CongressSubmission {
  id                 String    @id @default(uuid())
  publicationId      String
  congressId         String                                          // congress_id enum (ESMO, ASCO, …)
  congressName       String                                          // denormalised snapshot
  characterLimit     Int
  keywordsRequired   Int
  keywordsEntered    Int       @default(0)
  deadline           DateTime  @db.Date
  portalUrl          String
  characterCount     Int       @default(0)                            // computed from content at export time; frozen on this record
  status             String    @default("draft")                      // draft | exported | submitted | accepted | rejected
  exportedAt         DateTime?
  exportedBy         String?
  createdAt          DateTime  @default(now())

  publication        Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@map("congress_submissions")
  @@index([publicationId])
  @@index([publicationId, status])
}

// --------------------------------------------------------------------------
// 23.1 peer_review_rounds
// --------------------------------------------------------------------------

model PeerReviewRound {
  id                     String   @id @default(uuid())
  publicationId          String
  roundNumber            Int      @default(1)
  journalSubmissionRef   String                                     // e.g. 'NEJM-2026-28471'
  reviewerCount          Int      @default(3)
  submittedAt            DateTime?                                   // response letter submitted — round locked
  createdAt              DateTime @default(now())

  publication            Publication                @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  comments               ReviewerComment[]
  letterVersions         ResponseLetterVersion[]

  @@map("peer_review_rounds")
  @@unique([publicationId, roundNumber])
  @@index([publicationId])
}

// --------------------------------------------------------------------------
// 23.2 reviewer_comments — one row per reviewer or editor comment
// --------------------------------------------------------------------------

model ReviewerComment {
  id                   String    @id @default(uuid())
  roundId              String
  reviewerTab          String                                          // r1 | r2 | r3 | ed
  commentNumber        Int                                             // 1-based within reviewerTab
  commentText          String
  responseText         String    @default("")
  status               String    @default("not_started")                // not_started | drafting | responded
  // AI provenance when the response was AI-drafted + accepted. Match
  // the Part 11 shape in Module A ProvenanceRecord.
  aiDrafted            Boolean   @default(false)
  aiModel              String?
  aiGeneratedAt        DateTime?
  aiAcceptedBy         String?
  aiAcceptedAt         DateTime?
  respondedBy          String?
  respondedAt          DateTime?

  round                PeerReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("reviewer_comments")
  @@unique([roundId, reviewerTab, commentNumber])
  @@index([roundId])
  @@index([roundId, status])
}

// --------------------------------------------------------------------------
// 23.3 response_letter_versions — immutable snapshot per save
// --------------------------------------------------------------------------

model ResponseLetterVersion {
  id              String   @id @default(uuid())
  roundId         String
  letterVersion   String                                              // 'v1.N' — N = responded_count
  respondedCount  Int
  totalCount      Int
  contentHash     String                                              // sha256 of the assembled letter text
  createdBy       String
  createdAt       DateTime @default(now())

  round           PeerReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("response_letter_versions")
  @@index([roundId])
}
