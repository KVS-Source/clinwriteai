// Module C — Medical Writing models.
//
// Source: docs/demo/02-datamodel.md §28-§29 (content items, claims matrix,
// review tier, FK score, pre-MLR). Enum columns stored as TEXT with Zod
// validation at the route edge, same convention as Modules A and B.
//
// What's HERE:
//   - med_content_items (6-stage lifecycle, cross-module source FKs)
//   - claims_matrix_items
//   - review_tier_records (tier override log)
//   - fk_score_records (patient-facing readability)
//   - pre_mlr_check_results + pre_mlr_issues
//
// What's NOT here yet (externally blocked or scope-later):
//   - Claims similarity vector column (needs pgvector apt install — Phase 3C
//     plan risk; defer the column + similarity engine until pgvector is live)
//   - Agentic report tables (needs Anthropic key)
//   - MLR comments + decision tables (bigger scope — mini CRM)
//   - WCAG test records (axe-core + custom contrast checker not wired yet)
//   - ACCME CME compliance tables
//   - Content expiry scheduler state (BullMQ cron)

model MedContentItem {
  id                        String   @id @default(uuid())
  projectId                 String

  // Cross-module source links. sourceModuleAProjectId = originating clinical
  // project; sourceModuleBPubId optional link to the manuscript this piece
  // derives from. Both are read-only once set (DD-C-002).
  sourceModuleAProjectId    String
  sourceModuleBPubId        String?

  type                      String                                    // med_content_type (hcp_deck|mi_letter|pil|cme_module|…)
  title                     String
  status                    String   @default("briefing")              // med_content_status
  stage                     Int      @default(1)                       // 1..6
  complianceTrack           String                                     // compliance_track (promotional|non_promotional|cme|advisory)
  taTag                     String                                     // mandatory TA tag inherited at creation
  version                   String   @default("v0.1")
  channels                  String[] @default([])
  targetAudience            String[] @default([])

  // Derived fields (updated by routes/workers)
  reviewTier                String?                                    // review_tier (A|B|C)
  tierOverriddenBy          String?
  fkScore                   Decimal? @db.Decimal(4, 1)                 // most recent FK score (patient-facing)
  fkPassed                  Boolean?
  aiFootprintPct            Int?
  expiryDate                DateTime? @db.Date
  approvedAt                DateTime?
  medicalAffairsPlanId      String?
  publicationPlanId         String?

  ownerId                   String
  createdBy                 String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  archivedAt                DateTime?
  archiveReason             String?

  claims                    ClaimsMatrixItem[]
  reviewTiers               ReviewTierRecord[]
  fkScores                  FkScoreRecord[]
  preMlrRuns                PreMlrCheckResult[]

  @@map("med_content_items")
  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([taTag])
  @@index([expiryDate])
  @@index([sourceModuleAProjectId])
  @@index([sourceModuleBPubId])
}

// --------------------------------------------------------------------------
// 28.2 claims_matrix_items
// --------------------------------------------------------------------------

model ClaimsMatrixItem {
  id                   String    @id @default(uuid())
  contentItemId        String
  claimText            String
  sourceRef            String                                          // 'CSR v1.0 Table 14.2.1'
  sourceType           String                                          // smpc|csr|publication|label
  location             String                                          // 'Slide 12'
  approvalStatus       String    @default("new")                       // claim_status (new|approved|rejected|needs_edit|library_adopted)
  reviewerId           String?
  // similarity_pct will come from pgvector embeddings once that extension is
  // live. Phase 3C scaffold stores a plain Int so the harvest stub can seed
  // mock similarity values without blocking on pgvector.
  similarityPct        Int?
  approvedLibraryText  String?
  adoptedAt            DateTime?
  harvestedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contentItem          MedContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("claims_matrix_items")
  @@index([contentItemId])
  @@index([contentItemId, approvalStatus])
  @@index([contentItemId, similarityPct])
}

// --------------------------------------------------------------------------
// 28.3 review_tier_records — tier history + override log
// --------------------------------------------------------------------------

model ReviewTierRecord {
  id                String   @id @default(uuid())
  contentItemId     String
  tier              String                                            // review_tier
  reusePct          Int                                               // % approved+adopted claims
  calculatedAt      DateTime @default(now())
  overriddenBy      String?                                           // MLR Lead only
  overrideReason    String?

  contentItem       MedContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("review_tier_records")
  @@index([contentItemId])
}

// --------------------------------------------------------------------------
// 28.4 fk_score_records — Flesch-Kincaid readability
// --------------------------------------------------------------------------

model FkScoreRecord {
  id                String   @id @default(uuid())
  contentItemId     String
  score             Decimal  @db.Decimal(4, 1)
  // passed is computed at the service layer (score <= 8.0). Prisma can't
  // express a GENERATED column; a stored Boolean mirrors the computation.
  passed            Boolean
  calculatedAt      DateTime @default(now())
  bySection         Json     @default("[]")                            // [{sectionId, sectionLabel, score}]

  contentItem       MedContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@map("fk_score_records")
  @@index([contentItemId])
  @@index([contentItemId, calculatedAt])
}

// --------------------------------------------------------------------------
// 29.1 pre_mlr_check_results
// --------------------------------------------------------------------------

model PreMlrCheckResult {
  id                String   @id @default(uuid())
  contentItemId     String
  runAt             DateTime @default(now())
  mustFixCount      Int      @default(0)
  shouldFixCount    Int      @default(0)
  noteCount         Int      @default(0)
  passed            Boolean  @default(true)                            // service-level computed from mustFixCount
  runBy             String

  contentItem       MedContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  issues            PreMlrIssue[]

  @@map("pre_mlr_check_results")
  @@index([contentItemId])
  @@index([contentItemId, runAt])
}

// --------------------------------------------------------------------------
// 30.1 mlr_reviewers — one row per MLR reviewer per content item
// --------------------------------------------------------------------------

model MlrReviewer {
  id              String    @id @default(uuid())
  contentItemId   String
  userId          String                                              // User.id
  role            String                                              // 'MLR Medical Reviewer' | 'MLR Legal Reviewer' | 'MLR Regulatory Reviewer' | 'MLR Lead'
  assignedAt      DateTime  @default(now())
  submittedAt     DateTime?
  decision        String?                                             // mlr_decision: approved | rejected | needs_edit
  decisionNote    String?

  @@map("mlr_reviewers")
  @@unique([contentItemId, userId])
  @@index([contentItemId])
}

// --------------------------------------------------------------------------
// 30.2 mlr_comments — MLR review comments
// Human-readable IDs ('MLR-C-###') per-content; distinct from Module A comments.
// --------------------------------------------------------------------------

model MlrComment {
  id                     String    @id                                 // 'MLR-C-###' app-generated
  contentItemId          String
  reviewerId             String
  reviewerName           String                                        // denormalised at write time
  text                   String
  tag                    String                                        // Must Fix | Should Fix | Note
  resolvedAt             DateTime?
  resolvedBy             String?
  // Escalation path from the Agentic MLR advisory report (DD-C-xxx — sC06).
  escalatedFromAgentic   Boolean   @default(false)
  escalatedBy            String?
  escalatedAt            DateTime?
  createdAt              DateTime  @default(now())

  @@map("mlr_comments")
  @@index([contentItemId])
  @@index([contentItemId, tag])
}

// --------------------------------------------------------------------------
// 30.3 mlr_decision_records — immutable Part 11 record of MLR Lead decision
// --------------------------------------------------------------------------
//
// IMMUTABLE: application never updates existing rows. The e-signature chain
// binds `document_hash` + `credential_hash` + `meaning` + `timestamp_utc`
// per 21 CFR Part 11 §11.70. A customer-facing BAA restricts whether the
// 'rendered PDF' or 'canonical JSON' hash is bound here (open Compliance
// decision — see docs/compliance/Part11/compliance-assessment.md §Open items).

model MlrDecisionRecord {
  id                 String    @id @default(uuid())
  contentItemId      String
  decision           String                                            // mlr_decision
  decisionNote       String
  decidedBy          String
  decidedByName      String                                            // denormalised
  decidedByRole      String                                            // denormalised
  meaning            String                                            // 'I approve this content for external distribution'
  credentialHash     String                                            // sha256 of password re-auth proof; never plaintext
  documentHash       String                                            // sha256 of content state at decision time
  versionAtDecision  String                                            // 'v1.0' etc
  timestampUtc       DateTime
  authMethod         String    @default("password re-auth + TOTP")

  @@map("mlr_decision_records")
  @@index([contentItemId])
}

// --------------------------------------------------------------------------
// 29.2 pre_mlr_issues
// --------------------------------------------------------------------------

model PreMlrIssue {
  id                String   @id @default(uuid())
  checkResultId     String
  severity          String                                             // pre_mlr_severity (must_fix|should_fix|note)
  slide             String?                                            // 'Slide 12' (null for editorial)
  title             String
  detail            String
  suggestedFix      String?
  acknowledged      Boolean  @default(false)
  acknowledgedBy    String?
  acknowledgedAt    DateTime?

  checkResult       PreMlrCheckResult @relation(fields: [checkResultId], references: [id], onDelete: Cascade)

  @@map("pre_mlr_issues")
  @@index([checkResultId])
}

// --------------------------------------------------------------------------
// Pending med-content uploads (mirror of DocumentUpload in moduleA). Feeds
// POST /projects/:id/med-content/upload → classifier stub → user confirms
// via POST /:id/med-content/confirm-classification which creates the real
// MedContentItem and sets contentItemId here.
// --------------------------------------------------------------------------

model ContentUpload {
  id                   String   @id @default(uuid())
  projectId            String
  uploadedBy           String
  blobKey              String
  fileName             String
  fileSizeBytes        Int
  contentType          String
  virusScanStatus      String   @default("pending")
  classification       Json?
  status               String   @default("pending_classification")
  contentItemId        String?
  rejectionReason      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("content_uploads")
  @@index([projectId])
  @@index([status])
  @@index([contentItemId])
}

// --------------------------------------------------------------------------
// 28.7 med_slide_deck_jobs / med_slides / med_slide_figures
// --------------------------------------------------------------------------
//
// Slide-deck authoring for MedContentItem. Mirrors Module B's SlideDeckJob /
// Slide / SlideFigure (which is scoped to Publication) but attached to
// MedContentItem instead, so Module C can run its own AI slide generation
// without polluting Module B.
//
// AI pipeline mirrors clinical.ai_initial_draft:
//   - Deck job holds generation metadata (model, status, aiFootprintPct)
//   - One Slide row per slide (position, title, bodyHtml, speakerNotes)
//   - Slide rows written by the worker `med_content.ai_slide_draft` from
//     DocumentTypePolicy.smePrompt + bestPracticeDigest + existing slide
//     context (`policyVersionAtCreate` pinned on the deck).
//
// Added in migration 67 (2026-11-10).

model MedSlideDeckJob {
  id                      String   @id @default(uuid())
  contentItemId           String
  // Snapshot of the generation settings — same shape as Module B's deck job
  // so the two can converge later if we abstract.
  source                  String   @default("full-briefing")              // 'full-briefing' | 'claims-matrix' | 'manual'
  congressTarget          String?                                          // e.g. 'ASCO 2027' when deck is pitched for a venue
  slideCountLimit         Int      @default(25)                            // soft cap for full-deck jobs; single-slide generations ignore this
  status                  String   @default("draft")                       // 'draft' | 'generating' | 'ready' | 'exported'
  aiModel                 String?                                          // 'claude-sonnet-4-6' etc. — null until the first AI slide lands
  aiFootprintPct          Int?                                             // rough AI contribution %; computed by the worker
  policyVersionAtCreate   Int?                                             // DocumentTypePolicy.version pinned at deck creation (same mechanism as Document)
  generatedAt             DateTime?
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  slides                  MedSlide[]

  @@map("med_slide_deck_jobs")
  @@index([contentItemId])
  @@index([status])
}

model MedSlide {
  id                      String   @id @default(uuid())
  deckJobId               String
  position                Int                                              // 1-based slide number in the deck
  title                   String
  bodyHtml                String                                           // sanitised HTML body (lists, paragraphs)
  speakerNotes            String                                           // plain text; renders in Present mode (not yet shipped)
  // AI provenance per-slide — lets the Pre-MLR checker + audit reconstruct
  // what AI contributed vs. what the author edited. Mirrors clinical
  // SectionContent.aiSpanCount/humanSpanCount.
  aiGenerated             Boolean  @default(false)                         // flipped true on first AI write; author edits set to false on the next save (TBD)
  aiModel                 String?                                          // the model that produced this slide, if AI-drafted
  aiGeneratedAt           DateTime?
  aiPrompt                String?                                          // the free-text prompt the author gave the generator
  lastEditedBy            String?
  lastEditedAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  deckJob                 MedSlideDeckJob @relation(fields: [deckJobId], references: [id], onDelete: Cascade)
  figures                 MedSlideFigure[]

  @@map("med_slides")
  @@index([deckJobId])
  @@unique([deckJobId, position])
}

model MedSlideFigure {
  id              String   @id @default(uuid())
  slideId         String
  // Figure stays a reference for now — rendering the actual chart / image is
  // deferred. The AI generator fills `figureRef` + `altText` + a short
  // `figureDescription` so the slide can show a placeholder until a figure
  // asset is attached.
  figureRef       String                                                   // e.g. 'Fig-3', 'Table-2', 'CSR §16.4 Fig 1'
  altText         String                                                   // WCAG alt text (accessibility)
  figureDescription String                                                 // one-sentence what the figure shows
  createdAt       DateTime @default(now())

  slide           MedSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@map("med_slide_figures")
  @@index([slideId])
}
