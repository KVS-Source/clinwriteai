// Module D — Regulatory Writing models.
//
// Source: docs/demo/02-datamodel.md §37-§39 (core submission + consistency +
// redaction + validation). Enum columns stored as TEXT with Zod validation
// at route edge, same convention as earlier modules.
//
// What's HERE:
//   - regulatory_submissions (6-stage lifecycle; cross-module source link)
//   - ectd_granularity_nodes (DD-D-001 — Module 5 read-only)
//   - canonical_json_entries (indexed data points from Module A sources)
//   - cmc_readiness_reports
//   - consistency_check_results + consistency_contradictions
//     (DD-D-002 — major contradictions require resolution_note)
//   - redaction_records (DD-D-003 — immutable after stage 5)
//   - ectd_validation_results (stub; real Extedo/Lorenz integration later)
//
// What's NOT here yet (externally blocked or deferred scope):
//   - gateway_submissions (FDA ESG + CESP onboarding — months, needs vendor
//     contracts + PGP keys; MHRA apiReady=false in GATEWAY_PRIORITY)
//
// Added:
//   - ha_correspondence + ha_loq_questions + ha_response_drafts (§53)
//   - aggregate_safety_reports (PSUR/PBRER authoring — FR-D-015)
//   - odd_assessments (orphan drug designation)
//   - regulatory_alerts lives in platform-services.prisma (cross-module)

model RegulatorySubmission {
  id                        String   @id @default(uuid())
  projectId                 String
  // Cross-module read-only link to the originating Module A project.
  sourceModuleAProjectId    String
  submissionType            String                                       // reg_submission_type (ind|nda_maa|psur_pbrer|rmp_rems|ha_response|cer|orphan_drug)
  status                    String   @default("source_gathering")        // submission_status
  stage                     Int      @default(1)                          // 1..6
  targetHas                 String[] @default([])                         // target health authorities
  ectdVersion               String   @default("3.2.2")
  taTag                     String
  validatorEngine           String   @default("extedo")                   // validator_engine
  ownerId                   String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  ectdNodes                 EctdGranularityNode[]
  canonicalEntries          CanonicalJsonEntry[]
  cmcReport                 CmcReadinessReport?
  consistencyRuns           ConsistencyCheckResult[]
  redactionRecords          RedactionRecord[]
  validationRuns            EctdValidationResult[]
  haCorrespondence          HaCorrespondence[]
  aggregateSafetyReports    AggregateSafetyReport[]
  oddAssessments            OddAssessment[]
  documents                 RegulatoryDocument[]

  @@map("regulatory_submissions")
  @@index([projectId])
  @@index([status])
}

// --------------------------------------------------------------------------
// eCTD granularity nodes — real-time section status
// --------------------------------------------------------------------------

model EctdGranularityNode {
  id                 String   @id @default(uuid())
  submissionId       String
  moduleSection      String                                              // '2.5' | '3.2.S' | …
  sectionTitle       String
  status             String   @default("not_started")                     // ctd_module_status
  documentId         String?
  aiFootprintPct     Int?
  isReadOnly         Boolean  @default(false)                             // DD-D-001 — Module 5 nodes
  isSystemGenerated  Boolean  @default(false)                             // 2.1, 2.2, auto-generated
  lastUpdated        DateTime @default(now()) @updatedAt

  submission         RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("ectd_granularity_nodes")
  @@unique([submissionId, moduleSection])
  @@index([submissionId])
}

// --------------------------------------------------------------------------
// Canonical JSON — indexed data points from Module A source documents
// --------------------------------------------------------------------------

model CanonicalJsonEntry {
  id              String   @id @default(uuid())
  submissionId    String
  sourceDocId     String
  sourceType      String                                                 // csr|ib|sap|tlf|cmc|nonclin
  content         Json
  version         String
  indexedAt       DateTime @default(now())

  submission      RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("canonical_json_entries")
  @@index([submissionId])
}

// --------------------------------------------------------------------------
// CMC readiness — one row per submission (unique)
// --------------------------------------------------------------------------

model CmcReadinessReport {
  id                 String    @id @default(uuid())
  submissionId       String    @unique
  completenessPct    Int                                                  // 0..100
  missingItems       Json      @default("[]")
  generatedAt        DateTime  @default(now())
  acknowledgedBy     String?
  acknowledgedAt     DateTime?
  riskNote           String?

  submission         RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("cmc_readiness_reports")
}

// --------------------------------------------------------------------------
// Consistency check — cross-module/section contradiction detection
// --------------------------------------------------------------------------

model ConsistencyCheckResult {
  id              String   @id @default(uuid())
  submissionId    String
  runAt           DateTime @default(now())
  model           String                                                 // the AI engine or algorithm label
  // passed is service-computed (no unresolved major contradictions).
  passed          Boolean  @default(true)

  submission      RegulatorySubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  contradictions  ConsistencyContradiction[]

  @@map("consistency_check_results")
  @@index([submissionId])
}

model ConsistencyContradiction {
  id              String   @id @default(uuid())
  resultId        String
  sourceSection   String                                                 // 'Module 2.5 §3.1'
  targetSection   String                                                 // 'Module 5 §14.2.1'
  sourceValue     String
  targetValue     String
  severity        String                                                 // consistency_severity (major|minor)
  resolved        Boolean  @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNote  String?                                                // DD-D-002: required when resolving a major

  result          ConsistencyCheckResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("consistency_contradictions")
  @@index([resultId])
  @@index([resultId, resolved])
}

// --------------------------------------------------------------------------
// Redaction records — DD-D-003 immutable after stage 5
// --------------------------------------------------------------------------

model RedactionRecord {
  id                String   @id @default(uuid())
  submissionId      String
  documentId        String
  ppdItems          Json     @default("[]")                               // [{id, location, text, confirmed, confirmedBy}]
  cciItems          Json     @default("[]")
  stageAtCreation   Int                                                   // enforced-at-API layer immutability snapshot
  createdAt         DateTime @default(now())

  submission        RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("redaction_records")
  @@index([submissionId])
}

// --------------------------------------------------------------------------
// eCTD validation — stub for Extedo/Lorenz integration
// --------------------------------------------------------------------------

model EctdValidationResult {
  id              String   @id @default(uuid())
  submissionId    String
  runAt           DateTime @default(now())
  validator       String                                                 // validator_engine
  criticalCount   Int      @default(0)
  majorCount      Int      @default(0)
  minorCount      Int      @default(0)
  passed          Boolean  @default(true)                                 // service-computed: critical==0 && major==0
  errors          Json     @default("[]")

  submission      RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("ectd_validation_results")
  @@index([submissionId])
}

// --------------------------------------------------------------------------
// §53 HA Correspondence — post-submission authority round-trip
// Source: 02-datamodel.md §53, 03-api-contract.md §52.
//
// Lifecycle: inbound LoQ (direction=inbound, type=loq) arrives after a
// submission reaches stage 6. Questions are extracted into ha_loq_questions.
// Writers draft responses (ha_response_drafts, versioned per question).
// When all questions have an 'approved' draft, an outbound 'response' row
// closes the loop + stamps responded_at. ack / approval / nack are terminal
// authority replies.
// --------------------------------------------------------------------------

model HaCorrespondence {
  id              String   @id @default(uuid())
  submissionId    String
  direction       String                                                  // 'inbound' | 'outbound'
  type            String                                                  // 'loq' | 'response' | 'ack' | 'approval' | 'nack'
  contentSummary  String
  receivedAt      DateTime?
  respondedAt     DateTime?
  // Blob keys — point into BlobStorage. loq_doc_id anchors the uploaded LoQ
  // (PRD D v0.2 V-05 fix); response_doc_id anchors the compiled response.
  loqDocId        String?
  responseDocId   String?
  createdAt       DateTime @default(now())

  submission      RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questions       HaLoqQuestion[]

  @@map("ha_correspondence")
  @@index([submissionId])
  @@index([submissionId, type])
}

// Extracted per-question list from an inbound LoQ. Parse pipeline deferred —
// the POST /loq route currently accepts the questions in the request body
// (stub for the real DD-D-004 auto-parser).
model HaLoqQuestion {
  id                  String   @id @default(uuid())
  correspondenceId    String
  questionRef         String                                              // 'Q1', 'Q2.1' etc.
  questionText        String
  category            String?                                             // 'cmc' | 'clinical' | 'nonclinical' | 'labeling' | ...
  status              String   @default("open")                           // 'open' | 'drafting' | 'approved' | 'closed'
  sourceModuleRef     String?                                             // e.g. 'Module 3.2.P.3'
  dueDate             DateTime?
  responseAt          DateTime?

  correspondence      HaCorrespondence   @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)
  drafts              HaResponseDraft[]

  @@map("ha_loq_questions")
  @@unique([correspondenceId, questionRef])
  @@index([correspondenceId])
  @@index([correspondenceId, status])
}

// Versioned response drafts per question. Each generate call creates a new
// row; the latest approved draft wins for the compiled response letter.
model HaResponseDraft {
  id                  String   @id @default(uuid())
  questionId          String
  versionNumber       Int                                                 // monotonic per question
  draftText           String
  sourceRefs          String[] @default([])                               // canonical JSON refs
  aiFootprintPct      Int?
  status              String   @default("draft")                          // 'draft' | 'review' | 'approved' | 'rejected'
  reviewedBy          String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdBy           String
  createdAt           DateTime @default(now())

  question            HaLoqQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("ha_response_drafts")
  @@unique([questionId, versionNumber])
  @@index([questionId])
  @@index([questionId, status])
}

// --------------------------------------------------------------------------
// §54 Aggregate Safety Reports — PSUR / PBRER authoring surface (FR-D-015)
// Source: 04-acceptance-criteria.md AC-D-015, ICH E2C(R2).
//
// Deliberately scoped to the authoring + sign-off record; the AE line-list
// (ICSRs, line listings per MedDRA PT) lands with the MedDRA lookup when
// MSSO licensing clears. The signalSummary + benefitRiskSummary columns
// are the AI-authored sections AC-D-015 flags with the AI Footprint
// indicator and the PV Lead verification prompt.
// --------------------------------------------------------------------------

model AggregateSafetyReport {
  id                      String    @id @default(uuid())
  submissionId            String
  reportType              String                                        // 'psur' | 'pbrer'
  reportingPeriodStart    DateTime  @db.Date
  reportingPeriodEnd      DateTime  @db.Date
  dataLockPoint           DateTime  @db.Date
  status                  String    @default("draft")                   // 'draft' | 'under_review' | 'signed' | 'submitted'
  // AI-authored body sections. AI Footprint indicator (per AC-D-015) is
  // rendered by the UI off aiFootprintPct; the two body columns are HTML.
  signalSummary           String    @default("")
  benefitRiskSummary      String    @default("")
  aiFootprintPct          Int?
  // PV Lead sign-off anchor — the AC-D-015 verification gate. 'signed' can
  // only be set if pvLeadVerifiedAt is non-null (enforced at route edge).
  pvLeadVerifiedBy        String?
  pvLeadVerifiedAt        DateTime?
  pvLeadVerificationNote  String?

  generatedBy             String
  generatedAt             DateTime  @default(now())
  submittedAt             DateTime?

  submission              RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("aggregate_safety_reports")
  @@index([submissionId])
  @@index([submissionId, reportType])
  @@index([dataLockPoint])
}

// --------------------------------------------------------------------------
// §55 Orphan Drug Designation (ODD) assessments
// Source: 03-api-contract.md §53 ('odd_assessment_completed' audit event).
// --------------------------------------------------------------------------

model OddAssessment {
  id                        String    @id @default(uuid())
  submissionId              String
  // Clinical justification columns — authored by regulatory writers,
  // reviewed by medical lead, approved by the issuing authority.
  diseaseIndication         String
  prevalencePer100k         Decimal   @db.Decimal(8, 3)                 // '2.500' per 100k
  medicalNeedJustification  String
  significantBenefit        String?                                     // comparative benefit vs. existing
  status                    String    @default("draft")                 // 'draft' | 'under_review' | 'approved' | 'rejected' | 'withdrawn'
  // Authority outcome
  issuingAuthority          String?                                     // 'FDA' | 'EMA' | 'MHRA' | ...
  designationNumber         String?                                     // e.g. 'ODD-2026-0417'
  approvalDate              DateTime? @db.Date
  rejectionReason           String?

  completedBy               String?
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  submission                RegulatorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("odd_assessments")
  @@index([submissionId])
  @@index([status])
}

// ===== Phase M-D.1 — policy stack =======================================
// Mirror of Module C's MedContentTypePolicy / MedContentAiPromptRecord /
// MedContentBestPracticeRecord trio. docType values target the long-form
// narrative regulatory documents authored inside a submission:
//   ctd_m2_3_qos, ctd_m2_4_nonclin_overview, ctd_m2_5_clinical_overview,
//   ctd_m2_6_nonclin_summary, ctd_m2_7_clinical_summary, cover_letter,
//   qos, ha_response_narrative, etc.

model RegulatoryTypePolicy {
  id                  String    @id @default(uuid())
  docType             String
  version             Int
  isCurrent           Boolean   @default(true)
  templateId          String?
  checklistTemplateId String?
  regulatoryTrack     String?                                         // 'ind' | 'nda' | 'maa' | 'bla' | 'variation' | null
  reviewTierFormula   String?
  smePrompt           String    @default("")
  bestPracticeDigest  Json      @default("{\"principles\":[]}")
  sectionRules        Json      @default("{}")
  effectiveDate       DateTime  @default(now())
  retiredAt           DateTime?
  retiredBy           String?
  retireReason        String?
  supersededBy        String?
  createdBy           String
  updatedBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("regulatory_type_policies")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model RegulatoryAiPromptRecord {
  id            String    @id @default(uuid())
  docType       String
  version       Int
  status        String    @default("draft")                          // 'draft' | 'approved' | 'retired'
  smePrompt     String
  sectionRules  Json      @default("{}")
  supersededBy  String?
  effectiveDate DateTime?
  retiredAt     DateTime?
  retireReason  String?
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String
  updatedBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("regulatory_ai_prompt_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model RegulatoryBestPracticeRecord {
  id             String    @id @default(uuid())
  docType        String
  version        Int
  status         String    @default("draft")
  digest         Json      @default("{\"principles\":[]}")
  sourcePdfId    String?
  distilledAt    DateTime?
  distilledModel String?
  supersededBy   String?
  effectiveDate  DateTime?
  retiredAt      DateTime?
  retireReason   String?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("regulatory_best_practice_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model RegulatoryDocumentTemplate {
  id          String    @id @default(uuid())
  docType     String
  version     Int       @default(1)
  isCurrent   Boolean   @default(true)
  label       String
  description String    @default("")
  sections    Json      @default("[]")
  retiredAt   DateTime?
  retiredBy   String?
  createdBy   String
  updatedBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("regulatory_document_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model RegulatoryDocumentChecklistTemplate {
  id         String    @id @default(uuid())
  docType    String
  version    Int       @default(1)
  isCurrent  Boolean   @default(true)
  items      Json      @default("[]")
  retiredAt  DateTime?
  retiredBy  String?
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("regulatory_document_checklist_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

// ===== Phase M-D.2 — primary authoring entity =============================
// RegulatoryDocument is the long-form narrative document authored inside
// a submission. The eCTD node tree + canonical entries + CMC report +
// ODD remain untouched — they're the structural index. This is the
// writable surface: policy + versioning + sections + section locks.

model RegulatoryDocument {
  id                              String   @id @default(uuid())
  submissionId                    String
  projectId                       String
  docType                         String                                          // ctd_m2_3_qos | ctd_m2_4_nonclin_overview | ctd_m2_5_clinical_overview | ctd_m2_6_nonclin_summary | ctd_m2_7_clinical_summary | cover_letter | ha_response_narrative | risk_benefit_statement
  title                           String
  status                          String   @default("drafting")                   // drafting | in_review | approved | superseded | archived
  stage                           Int      @default(1)                            // 1..6
  regulatoryTrack                 String?                                         // ind | nda | maa | bla | variation | other
  version                         String   @default("v0.1")

  regTypePolicyVersionAtCreate    Int?      @map("reg_type_policy_version_at_create")
  regAiPromptRecordId             String?   @map("reg_ai_prompt_record_id")
  regAiPromptVersionAtCreate      Int?      @map("reg_ai_prompt_version_at_create")
  regBestPracticeRecordId         String?   @map("reg_best_practice_record_id")
  regBestPracticeVersionAtCreate  Int?      @map("reg_best_practice_version_at_create")

  aiDraftState                    String    @default("idle") @map("ai_draft_state_d")   // idle | drafting | validating | complete | failed
  aiInstructions                  String?   @map("ai_instructions_d")

  ownerId                         String
  createdBy                       String
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  archivedAt                      DateTime?
  archiveReason                   String?

  currentVersionId                String?   @unique @map("current_version_id")

  submission                      RegulatorySubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versions                        RegulatoryDocumentVersion[] @relation("RegulatoryDocumentVersions")
  currentVersion                  RegulatoryDocumentVersion?  @relation("RegulatoryDocumentCurrentVersion", fields: [currentVersionId], references: [id])

  @@map("regulatory_documents")
  @@index([submissionId])
  @@index([projectId])
  @@index([docType])
  @@index([status])
  @@index([regAiPromptRecordId])
  @@index([regBestPracticeRecordId])
}

model RegulatoryDocumentVersion {
  id                    String   @id @default(uuid())
  regulatoryDocumentId  String
  versionNumber         String
  label                 String
  contentHash           String
  isCurrent             Boolean  @default(true)
  createdBy             String
  createdAt             DateTime @default(now())
  restoreSource         Json?

  document              RegulatoryDocument             @relation("RegulatoryDocumentVersions", fields: [regulatoryDocumentId], references: [id], onDelete: Cascade)
  sections              RegulatoryDocumentSection[]
  currentOf             RegulatoryDocument?            @relation("RegulatoryDocumentCurrentVersion")

  @@map("regulatory_document_versions")
  @@unique([regulatoryDocumentId, versionNumber])
  @@index([regulatoryDocumentId])
}

model RegulatoryDocumentSection {
  id                             String    @id @default(uuid())
  regulatoryDocumentVersionId    String
  sectionId                      String
  sectionNumber                  String
  sectionTitle                   String
  contentHtml                    String    @default("")
  wordCount                      Int       @default(0)
  aiSpanCount                    Int       @default(0)
  humanSpanCount                 Int       @default(0)
  lastEditedBy                   String?
  lastEditedAt                   DateTime?
  aiConfidence                   Int?       @map("ai_confidence")
  aiFlags                        String[]   @default([]) @map("ai_flags")

  // Section template pin (migration 90, NL rules in 91) — same as SectionContent.
  sectionTemplateRecordId        String?    @map("section_template_record_id")
  templateFormatRules            String?    @map("template_format_rules")

  version                        RegulatoryDocumentVersion @relation(fields: [regulatoryDocumentVersionId], references: [id], onDelete: Cascade)

  @@map("regulatory_document_sections")
  @@unique([regulatoryDocumentVersionId, sectionId])
  @@index([regulatoryDocumentVersionId])
}

model RegulatoryDocumentSectionLock {
  id                     String    @id @default(uuid())
  regulatoryDocumentId   String
  sectionId              String
  userId                 String
  acquiredAt             DateTime  @default(now())
  lastHeartbeatAt        DateTime  @default(now())

  @@map("regulatory_document_section_locks")
  @@unique([regulatoryDocumentId, sectionId])
  @@index([userId])
  @@index([lastHeartbeatAt])
}

// --- Phase M-D.5 ----------------------------------------------------------
// Threaded comments on regulatory document sections. Mirror of
// MedContentSectionComment / PublicationSectionComment.

model RegulatoryDocumentSectionComment {
  id                     String    @id @default(uuid())
  regulatoryDocumentId   String
  sectionId              String
  authorId               String
  authorName             String
  text                   String
  severity               String    @default("info")                             // info | warning | blocking
  status                 String    @default("open")                             // open | resolved
  resolvedBy             String?
  resolvedAt             DateTime?
  resolutionNote         String?
  parentCommentId        String?
  mentionedUserIds       String[]  @default([])
  createdAt              DateTime  @default(now())

  @@map("regulatory_document_section_comments")
  @@index([regulatoryDocumentId])
  @@index([regulatoryDocumentId, sectionId])
  @@index([parentCommentId])
}
