// Module E — Ideation & Publishing models.
//
// Source: docs/demo/02-datamodel.md §45-§48 (ideation projects, artefacts,
// content cards, atomised content, claim currency, contacts, calendar,
// publish records, DOI, Dublin Core).
//
// Enum columns stored as TEXT with Zod validation at route edge, same
// convention as earlier modules.
//
// What's HERE:
//   - ideation_projects, ideation_artefacts, ideation_content_cards
//   - atomised_content (UNIQUE per card+channel)
//   - claim_currency_checks
//   - kol_contacts, ma_contacts (mobile_encrypted deferred — see below)
//   - calendar_entries, publish_records (1-1 with calendar)
//   - doi_records, dublin_core_metadata
//
// What's NOT here yet (externally blocked or scope-later):
//   - social_listening_alerts (needs real listening wiring)
//   - mobile_encrypted field encryption (needs key management decision —
//     column is a plain TEXT for now with a comment flagging the TODO)
//   - Public KOL guest JWT route (threat model + WAF rules required)
//   - CrossRef DOI minting integration (same procurement blocker as Module B)

model IdeationProject {
  id              String   @id @default(uuid())
  projectId       String
  sourceType      String                                          // master_library | upload | external
  taTag           String
  status          String   @default("uploaded")                    // ideation_stage
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  artefacts       IdeationArtefact[]
  kolContacts     KolContact[]
  maContacts      MaContact[]

  @@map("ideation_projects")
  @@index([projectId])
}

model IdeationArtefact {
  id                     String   @id @default(uuid())
  ideationProjectId      String
  sourceModule           String?                                   // A|B|C|D|external
  sourceDocId            String?
  filePath               String?
  title                  String
  originalApprovalDate   DateTime @db.Date
  version                String
  sourceCurrencyStatus   String   @default("current")              // source_currency_status
  approvalStatusCheck    String   @default("pending")              // passed|blocked|confirmed_external|pending
  masterLibraryPushDate  DateTime? @db.Date                        // null for uploads; set for Master Library pulls

  // Phase M-E.1 — docType pin + policy stack pointers.
  docType                              String?  @map("doc_type")
  ideationTypePolicyVersionAtCreate    Int?     @map("ideation_type_policy_version_at_create")
  ideationAiPromptRecordId             String?  @map("ideation_ai_prompt_record_id")
  ideationAiPromptVersionAtCreate      Int?     @map("ideation_ai_prompt_version_at_create")
  ideationBestPracticeRecordId         String?  @map("ideation_best_practice_record_id")
  ideationBestPracticeVersionAtCreate  Int?     @map("ideation_best_practice_version_at_create")

  // Phase M-E.2 — ownership + AI draft state + versioned content.
  ownerId                              String?  @map("owner_id")
  aiDraftState                         String   @default("idle") @map("ai_draft_state_e")   // idle | drafting | validating | complete | failed
  aiInstructions                       String?  @map("ai_instructions_e")
  currentVersionId                     String?  @unique @map("current_version_id")

  ideationProject        IdeationProject                 @relation(fields: [ideationProjectId], references: [id], onDelete: Cascade)
  cards                  IdeationContentCard[]
  currencyChecks         ClaimCurrencyCheck[]
  versions               IdeationArtefactVersion[]       @relation("IdeationArtefactVersions")
  currentVersion         IdeationArtefactVersion?        @relation("IdeationArtefactCurrentVersion", fields: [currentVersionId], references: [id])

  @@map("ideation_artefacts")
  @@index([ideationProjectId])
  @@index([docType])
  @@index([ideationAiPromptRecordId])
  @@index([ideationBestPracticeRecordId])
}

// --- Phase M-E.2 ----------------------------------------------------------

model IdeationArtefactVersion {
  id                    String   @id @default(uuid())
  ideationArtefactId    String
  versionNumber         String
  label                 String
  contentHash           String
  isCurrent             Boolean  @default(true)
  createdBy             String
  createdAt             DateTime @default(now())
  restoreSource         Json?

  artefact              IdeationArtefact             @relation("IdeationArtefactVersions", fields: [ideationArtefactId], references: [id], onDelete: Cascade)
  sections              IdeationArtefactSection[]
  currentOf             IdeationArtefact?            @relation("IdeationArtefactCurrentVersion")

  @@map("ideation_artefact_versions")
  @@unique([ideationArtefactId, versionNumber])
  @@index([ideationArtefactId])
}

model IdeationArtefactSection {
  id                             String    @id @default(uuid())
  ideationArtefactVersionId      String
  sectionId                      String
  sectionNumber                  String
  sectionTitle                   String
  contentHtml                    String    @default("")
  wordCount                      Int       @default(0)
  aiSpanCount                    Int       @default(0)
  humanSpanCount                 Int       @default(0)
  lastEditedBy                   String?
  lastEditedAt                   DateTime?
  aiConfidence                   Int?       @map("ai_confidence")
  aiFlags                        String[]   @default([]) @map("ai_flags")

  // Section template pin (migration 90, NL rules in 91) — same as SectionContent.
  sectionTemplateRecordId        String?    @map("section_template_record_id")
  templateFormatRules            String?    @map("template_format_rules")

  version                        IdeationArtefactVersion @relation(fields: [ideationArtefactVersionId], references: [id], onDelete: Cascade)

  @@map("ideation_artefact_sections")
  @@unique([ideationArtefactVersionId, sectionId])
  @@index([ideationArtefactVersionId])
}

model IdeationArtefactSectionLock {
  id                   String    @id @default(uuid())
  ideationArtefactId   String
  sectionId            String
  userId               String
  acquiredAt           DateTime  @default(now())
  lastHeartbeatAt      DateTime  @default(now())

  @@map("ideation_artefact_section_locks")
  @@unique([ideationArtefactId, sectionId])
  @@index([userId])
  @@index([lastHeartbeatAt])
}

// --- Phase M-E.5 ----------------------------------------------------------

model IdeationArtefactSectionComment {
  id                   String    @id @default(uuid())
  ideationArtefactId   String
  sectionId            String
  authorId             String
  authorName           String
  text                 String
  severity             String    @default("info")                             // info | warning | blocking
  status               String    @default("open")                             // open | resolved
  resolvedBy           String?
  resolvedAt           DateTime?
  resolutionNote       String?
  parentCommentId      String?
  mentionedUserIds     String[]  @default([])
  createdAt            DateTime  @default(now())

  @@map("ideation_artefact_section_comments")
  @@index([ideationArtefactId])
  @@index([ideationArtefactId, sectionId])
  @@index([parentCommentId])
}

// --------------------------------------------------------------------------
// ideation_content_cards — overall_status is denormalised from
// kol_status + ma_status (service-layer derivation on every write).
// --------------------------------------------------------------------------

model IdeationContentCard {
  id                   String   @id @default(uuid())
  ideationArtefactId   String
  sourceSection        String
  sourcePassage        String
  claimCurrencyStatus  String   @default("current")                // claim_currency_status
  channelFormats       String[] @default([])
  kolStatus            String   @default("pending")                 // pending | approved | rejected
  maStatus             String   @default("pending")                 // pending | approved | rejected
  overallStatus        String   @default("uploaded")                // derived — content_card_status
  provenance           Json     @default("{}")
  createdAt            DateTime @default(now())

  artefact             IdeationArtefact       @relation(fields: [ideationArtefactId], references: [id], onDelete: Cascade)
  atomised             AtomisedContent[]
  calendarEntries      CalendarEntry[]
  doiRecord            DoiRecord?
  dublinCoreMetadata   DublinCoreMetadata?

  @@map("ideation_content_cards")
  @@index([ideationArtefactId])
  @@index([overallStatus])
}

// --------------------------------------------------------------------------
// atomised_content — one row per channel adaptation of a card
// --------------------------------------------------------------------------

model AtomisedContent {
  id                        String   @id @default(uuid())
  ideationContentCardId     String
  channel                   String                                 // channel_format
  contentText               String
  aiGenerated               Boolean  @default(true)
  aiFootprintHash           String
  brandScreenPassed         Boolean  @default(false)
  complianceScreenPassed    Boolean  @default(false)
  createdAt                 DateTime @default(now())

  card                      IdeationContentCard @relation(fields: [ideationContentCardId], references: [id], onDelete: Cascade)

  @@map("atomised_content")
  @@unique([ideationContentCardId, channel])
  @@index([ideationContentCardId])
}

// --------------------------------------------------------------------------
// claim_currency_checks — ran against the artefact (not the cards)
// --------------------------------------------------------------------------

model ClaimCurrencyCheck {
  id                   String    @id @default(uuid())
  ideationArtefactId   String
  runAt                DateTime  @default(now())
  claimsExtracted      Json      @default("[]")
  supersededClaims     Json      @default("[]")
  conflictingClaims    Json      @default("[]")
  acknowledgedBy       String?
  acknowledgedAt       DateTime?

  artefact             IdeationArtefact @relation(fields: [ideationArtefactId], references: [id], onDelete: Cascade)

  @@map("claim_currency_checks")
  @@index([ideationArtefactId])
}

// --------------------------------------------------------------------------
// kol_contacts / ma_contacts — external reviewer directory
// mobile_encrypted is PLAIN TEXT in the scaffold with a TODO for the
// key-management decision (see memory project_phase_3e_deferrals).
// --------------------------------------------------------------------------

model KolContact {
  id                     String    @id @default(uuid())
  ideationProjectId      String
  name                   String
  email                  String
  // TODO(encrypt): rotate to envelope-encrypted TEXT once KMS strategy picked.
  mobileEncrypted        String?
  reviewLinkToken        String                                    // one-time JWT, 7-day expiry
  reviewLinkExpiry       DateTime
  signedOffAt            DateTime?
  reminder1SentAt        DateTime?
  reminder2SentAt        DateTime?
  escalatedAt            DateTime?

  ideationProject        IdeationProject @relation(fields: [ideationProjectId], references: [id], onDelete: Cascade)

  @@map("kol_contacts")
  @@index([ideationProjectId])
}

model MaContact {
  id                     String   @id @default(uuid())
  ideationProjectId      String
  role                   String                                    // lead | member
  name                   String
  email                  String
  // TODO(encrypt): same as KolContact.
  mobileEncrypted        String?
  notificationPreference String   @default("email_sms")

  ideationProject        IdeationProject @relation(fields: [ideationProjectId], references: [id], onDelete: Cascade)

  @@map("ma_contacts")
  @@index([ideationProjectId])
}

// --------------------------------------------------------------------------
// calendar_entries + publish_records
// --------------------------------------------------------------------------

model CalendarEntry {
  id                       String    @id @default(uuid())
  ideationContentCardId    String
  channel                  String                                  // channel_format
  scheduledDate            DateTime  @db.Date
  assignedCreativeId       String?
  status                   String    @default("scheduled")          // scheduled|published|overdue|cancelled
  publishedAt              DateTime?
  publishedBy              String?

  card                     IdeationContentCard @relation(fields: [ideationContentCardId], references: [id], onDelete: Cascade)
  publishRecord            PublishRecord?

  @@map("calendar_entries")
  @@index([scheduledDate])
}

model PublishRecord {
  id                  String   @id @default(uuid())
  calendarEntryId     String   @unique
  channel             String
  publishedAt         DateTime
  publishedBy         String
  utmParams           String?
  seoMetadata         Json     @default("{}")
  sentimentScore      Decimal? @db.Decimal(4, 2)
  sentimentAlertSent  Boolean  @default(false)

  calendarEntry       CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  @@map("publish_records")
}

// --------------------------------------------------------------------------
// doi_records + dublin_core_metadata — one row per card
// --------------------------------------------------------------------------

model DoiRecord {
  id                       String   @id @default(uuid())
  ideationContentCardId    String   @unique
  doi                      String
  registeredAt             DateTime @default(now())
  crossrefResponse         Json     @default("{}")

  card                     IdeationContentCard @relation(fields: [ideationContentCardId], references: [id], onDelete: Cascade)

  @@map("doi_records")
}

model DublinCoreMetadata {
  id                       String   @id @default(uuid())
  ideationContentCardId    String   @unique
  dcTitle                  String
  dcCreator                String
  dcSubject                String
  dcDescription            String
  dcDate                   DateTime @db.Date
  dcType                   String
  dcFormat                 String
  dcIdentifier             String?                                 // DOI if registered
  dcRights                 String
  dcLanguage               String   @default("en")
  dcSource                 String?
  dcRelation               String?
  dcCoverage               String?
  dcPublisher              String?
  dcContributor            String?
  taggedAt                 DateTime @default(now())

  card                     IdeationContentCard @relation(fields: [ideationContentCardId], references: [id], onDelete: Cascade)

  @@map("dublin_core_metadata")
}

// ===== Phase M-E.1 — policy stack =======================================
// Mirror of Module D's RegulatoryTypePolicy trio. docType values target
// the authored ideation artefact kinds (kol_engagement_brief,
// patient_story, hcp_insight_report, medical_affairs_narrative,
// disease_awareness_brief, press_release, etc.).

model IdeationTypePolicy {
  id                  String    @id @default(uuid())
  docType             String
  version             Int
  isCurrent           Boolean   @default(true)
  templateId          String?
  checklistTemplateId String?
  channelHint         String?                                        // 'kol' | 'hcp' | 'patient' | 'press' | null
  reviewTierFormula   String?
  smePrompt           String    @default("")
  bestPracticeDigest  Json      @default("{\"principles\":[]}")
  sectionRules        Json      @default("{}")
  effectiveDate       DateTime  @default(now())
  retiredAt           DateTime?
  retiredBy           String?
  retireReason        String?
  supersededBy        String?
  createdBy           String
  updatedBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("ideation_type_policies")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model IdeationAiPromptRecord {
  id            String    @id @default(uuid())
  docType       String
  version       Int
  status        String    @default("draft")                          // 'draft' | 'approved' | 'retired'
  smePrompt     String
  sectionRules  Json      @default("{}")
  supersededBy  String?
  effectiveDate DateTime?
  retiredAt     DateTime?
  retireReason  String?
  approvedBy    String?
  approvedAt    DateTime?
  createdBy     String
  updatedBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("ideation_ai_prompt_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model IdeationBestPracticeRecord {
  id             String    @id @default(uuid())
  docType        String
  version        Int
  status         String    @default("draft")
  digest         Json      @default("{\"principles\":[]}")
  sourcePdfId    String?
  distilledAt    DateTime?
  distilledModel String?
  supersededBy   String?
  effectiveDate  DateTime?
  retiredAt      DateTime?
  retireReason   String?
  approvedBy     String?
  approvedAt     DateTime?
  createdBy      String
  updatedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("ideation_best_practice_records")
  @@unique([docType, version])
  @@index([docType, status])
  @@index([status])
}

model IdeationArtefactTemplate {
  id          String    @id @default(uuid())
  docType     String
  version     Int       @default(1)
  isCurrent   Boolean   @default(true)
  label       String
  description String    @default("")
  sections    Json      @default("[]")
  retiredAt   DateTime?
  retiredBy   String?
  createdBy   String
  updatedBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ideation_artefact_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}

model IdeationArtefactChecklistTemplate {
  id         String    @id @default(uuid())
  docType    String
  version    Int       @default(1)
  isCurrent  Boolean   @default(true)
  items      Json      @default("[]")
  retiredAt  DateTime?
  retiredBy  String?
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ideation_artefact_checklist_templates")
  @@unique([docType, version])
  @@index([docType, isCurrent])
}
