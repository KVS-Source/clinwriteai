// Platform-wide services (Phase 4) — Master Library, Notifications,
// Framework registry, RACI matrix, AI gateway accounting.
//
// All feature modules consume these; no module owns them.

// --------------------------------------------------------------------------
// Master Library — reusable approved content
// --------------------------------------------------------------------------
//
// The Master Library stores approved snippets of text (claims, boilerplate,
// safety language, best practices) that modules B, C, D, E reference. Each
// row is a "section" tagged by TA + framework + status. Modules query by
// similarity (handled at the service layer; the DB stores plain text here
// and gets a pgvector embedding column once that extension is live).

model LibrarySection {
  id              String   @id @default(uuid())
  tenantId        String?                                            // null = platform-wide
  title           String
  body            String                                             // the approved text
  taTag           String                                             // mandatory TA (Oncology, etc.)
  framework       String                                             // 'ICH E3' | 'FDA Label' | 'Custom'
  category        String                                             // claim | safety | boilerplate | best_practice
  version         Int      @default(1)
  isCurrent       Boolean  @default(true)
  usageCount      Int      @default(0)                                // bumped on adoption via /library/sections/:id/adopt
  approvedBy      String                                             // user id
  approvedAt      DateTime @default(now())
  supersededBy    String?                                            // FK to the newer section id (nullable)
  retiredAt       DateTime?
  tags            String[] @default([])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("library_sections")
  @@index([taTag])
  @@index([framework])
  @@index([category])
  @@index([tenantId, isCurrent])
}

model LibraryAdoptionRecord {
  id              String   @id @default(uuid())
  libraryId       String                                             // FK to LibrarySection.id (loose — allows retirements)
  adoptingModule  String                                             // 'B' | 'C' | 'D' | 'E'
  adoptingEntity  String                                             // publication id | content item id | …
  adoptedBy       String
  adoptedAt       DateTime @default(now())

  @@map("library_adoption_records")
  @@index([libraryId])
  @@index([adoptingModule, adoptingEntity])
}

// --------------------------------------------------------------------------
// Notifications — in-app + email + SMS fan-out
// --------------------------------------------------------------------------

model Notification {
  id              String    @id @default(uuid())
  recipientId     String                                             // User.id of the human recipient
  kind            String                                             // 'review_assigned' | 'comment_added' | 'stage_advanced' | …
  severity        String    @default("info")                         // info | warning | critical
  title           String
  body            String
  linkPath        String?                                            // '/projects/X/documents/Y' — opens the thing in app
  channels        String[]  @default(["in_app"])                     // in_app | email | sms (any combination)
  payload         Json      @default("{}")
  readAt          DateTime?
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())

  deliveries      NotificationDelivery[]

  @@map("notifications")
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model NotificationDelivery {
  id             String    @id @default(uuid())
  notificationId String
  channel        String                                             // in_app | email | sms
  attemptedAt    DateTime  @default(now())
  deliveredAt    DateTime?
  provider       String?                                            // 'ses' | 'sendgrid' | 'twilio' | 'internal'
  providerRef    String?                                            // message id from the provider
  error          String?

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_deliveries")
  @@index([notificationId])
  @@index([channel, deliveredAt])
}

// --------------------------------------------------------------------------
// Framework registry (Admin + Super Admin)
// --------------------------------------------------------------------------

model RegulatoryFramework {
  id              String   @id @default(uuid())
  name            String   @unique                                   // 'ICH E3' | 'FDA Label' | 'EU CTR Art 37' | …
  version         String                                             // 'r1 2016' | '2024-05' | …
  jurisdiction    String                                             // 'ICH' | 'US' | 'EU' | 'UK' | …
  category        String                                             // clinical | regulatory | compliance | …
  effectiveDate   DateTime @db.Date
  retiredAt       DateTime?
  description     String?
  // Human-maintained reference URL — used by the UI to open the spec. Not
  // a canonical source of truth (contract compliance teams own that).
  sourceUrl       String?

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("regulatory_frameworks")
  @@index([jurisdiction])
  @@index([category])
}

// --------------------------------------------------------------------------
// RACI matrix — platform-wide RACI role definitions per project activity
// --------------------------------------------------------------------------

model RaciAssignment {
  id              String   @id @default(uuid())
  projectId       String
  activity        String                                             // 'clinical_writing.draft' | 'regulatory.publish' | …
  responsibleId   String?
  accountableId   String?
  consultedIds    String[] @default([])
  informedIds     String[] @default([])
  notes           String?
  updatedBy       String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("raci_assignments")
  @@unique([projectId, activity])
  @@index([projectId])
}

// --------------------------------------------------------------------------
// AI Gateway accounting (central Anthropic wrapper)
// --------------------------------------------------------------------------

model AiCallRecord {
  id              String   @id @default(uuid())
  tenantId        String?
  projectId       String?
  actorId         String
  module          String                                             // 'A' | 'B' | 'C' | 'D' | 'E' | 'platform'
  intent          String                                             // 'draft_section' | 'claims_harvest' | 'atomise' | …
  model           String                                             // claude-opus-4-7 | claude-sonnet-4-6 | …
  inputTokens     Int                                                 // reported by the SDK
  outputTokens    Int
  cachedTokens    Int      @default(0)                                // prompt-caching discount
  // USD cost rolled up at write time from a per-model rate card; stable
  // across rate-card changes so historical totals don't shift.
  costUsd         Decimal  @db.Decimal(10, 6)
  latencyMs       Int
  // Rate-limit outcome: 'allowed' | 'allowed_approaching_cap' | 'rejected_cap'
  limitDecision   String   @default("allowed")
  piiScrubbed     Boolean  @default(false)                            // true if the request had PII that was redacted
  errorCode       String?                                             // null on success; 'rate_limited'|'provider_err'|…
  // Which rate-card version priced this record. Nullable — historical rows
  // written before rate-card hot-reload shipped have NULL and stay valid.
  rateCardVersionId String?
  createdAt       DateTime @default(now())

  rateCardVersion RateCardVersion? @relation(fields: [rateCardVersionId], references: [id])

  @@map("ai_call_records")
  @@index([tenantId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@index([module, createdAt])
}

// --------------------------------------------------------------------------
// Rate cards — DB-backed with version history. Replaces the in-code RATES
// array for new calls; old AiCallRecord rows stay valid via nullable FK.
//
// Invariant: exactly one row with isActive=true at a time (admin routes
// enforce via tx). Lookups are cached in-process for 60s to avoid a DB
// round-trip on every AI call.
// --------------------------------------------------------------------------

model RateCardVersion {
  id            String   @id @default(uuid())
  version       String   @unique                                       // 'v1', 'v2026-10-01', ...
  publishedBy   String
  publishedAt   DateTime @default(now())
  isActive      Boolean  @default(true)
  notes         String?                                                // changelog entry

  entries       RateCardEntry[]
  aiCallRecords AiCallRecord[]

  @@map("rate_card_versions")
  @@index([isActive])
}

model RateCardEntry {
  id                String   @id @default(uuid())
  rateCardVersionId String
  model             String                                              // 'claude-opus-4-7' | ...
  inputPer1M        Decimal  @db.Decimal(10, 4)                         // USD per 1M input tokens
  outputPer1M       Decimal  @db.Decimal(10, 4)
  cachedInputPer1M  Decimal  @db.Decimal(10, 4)

  version           RateCardVersion @relation(fields: [rateCardVersionId], references: [id], onDelete: Cascade)

  @@map("rate_card_entries")
  @@unique([rateCardVersionId, model])
  @@index([rateCardVersionId])
}

// Per-tenant monthly caps so the gateway can enforce "cost control is a real
// line item at scale" (plan §4). Phase 4 ships hard caps; soft-cap
// notifications (80%, 95%) land with the Notification engine (Batch 2).
model AiTenantQuota {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  // 6-decimal precision matches AiCallRecord.costUsd so sub-cent caps don't
  // silently round to zero (previously flipped quota semantic from "tiny
  // cap" to "cap off" — now cap=0 explicitly means "no AI allowed").
  monthlyCapUsd   Decimal  @db.Decimal(14, 6)
  warnAtPct       Int      @default(80)
  rejectAtPct     Int      @default(100)
  rolloverDay     Int      @default(1)                                // day of month quota resets

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_tenant_quotas")
}

// --------------------------------------------------------------------------
// Regulatory alerts — cross-module push service (FR-D-024).
// Source: 02-datamodel.md §53, 03-api-contract.md §53.
//
// Framework change notifications (ICH E3 update, FDA guidance revision,
// EMA SmPC template change) are published here by super-admins and
// pushed to all five modules. Users acknowledge per-alert; the alert
// stays visible until the effective_date passes.
//
// Lives in platform-services (not moduleD) because every module reads it.
// --------------------------------------------------------------------------

// --------------------------------------------------------------------------
// Taxonomy — therapeutic areas (TA tags) normalised.
//
// Free-text TA strings are scattered across projects.therapeuticArea,
// library_sections.taTag, med_content_items.taTag, regulatory_submissions.taTag,
// ideation_projects.taTag etc. This table is the canonical list; writers
// are encouraged (not forced) to use its `code` values. Existing free-text
// columns stay in place for backwards compat — a bulk reconciliation lands
// when the TA catalogue is signed off by the medical writing lead.
//
// Hierarchy: parentCode is nullable so we can model 'Oncology' > 'Haematologic
// Malignancies' > 'MDS'. Admins own CRUD; every authed user can read.
// --------------------------------------------------------------------------

model TherapeuticArea {
  code          String   @id                                       // 'ONC', 'ONC-HAEM', 'CARD', ...
  label         String                                             // 'Oncology', 'Haematologic malignancies'
  parentCode    String?                                            // null for top-level TAs
  status        String   @default("active")                        // 'active' | 'archived'
  description   String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  archivedAt    DateTime?

  parent        TherapeuticArea?   @relation("TaParent", fields: [parentCode], references: [code])
  children      TherapeuticArea[]  @relation("TaParent")

  @@map("therapeutic_areas")
  @@index([parentCode])
  @@index([status])
}

model RegulatoryAlert {
  id                  String    @id @default(uuid())
  frameworkName       String                                           // 'ICH E3', 'FDA Guidance 2026-01', ...
  changeSummary       String
  effectiveDate       DateTime  @db.Date
  affectedModules     String[]  @default([])                           // ['A','B','C','D','E'] subset
  severity            String    @default("info")                       // 'info' | 'warning' | 'breaking'
  sourceUrl           String?
  alertedAt           DateTime  @default(now())
  acknowledgedByIds   String[]  @default([])                           // User.id list
  publishedBy         String                                           // super-admin User.id
  archivedAt          DateTime?

  @@map("regulatory_alerts")
  @@index([alertedAt(sort: Desc)])
  @@index([effectiveDate])
}
