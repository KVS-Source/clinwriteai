// Platform-layer models — users, sessions, projects, tenants.
// Lands fully in Phase 1 Week 3. Stub shapes here so Prisma generates
// a client the API scaffold can import.
//
// Source of truth for the full model set: docs/demo/02-datamodel.md

// --------------------------------------------------------------------------
// Users + sessions (Phase 1 Week 3 — real)
// --------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  initials      String?
  // Platform-level role. See docs/roles-and-permissions.md §2.
  // Values during cutover:
  //   LEGACY (pre-migration-47): 'super-admin' | 'admin' | 'clinical-writer' | …
  //   TARGET (post-migration-48): 'tenant-admin' | 'pm' | 'contributor' | 'auditor' | 'guest'
  // Migration 47 only *adds* capabilities + legacy_role columns. Migration 48
  // (follow-up) rewrites values and the middleware simultaneously.
  role          String
  // Per-user capability flags (post migration 48). Governs which RACI letters
  // a PM can assign this user — see docs/roles-and-permissions.md §2.1.
  //   ['can-author','can-review','can-approve','can-publish']
  capabilities  String[] @default([])
  // Snapshot of role at migration time, kept 90d for audit-chain interpretation
  // of pre-migration events. Dropped in a later migration.
  legacyRole    String?
  modules       String[] @default([])    // ['A', 'B', 'C', 'D', 'E']
  status        String   @default("invited")  // invited | active | suspended | deprovisioned
  lastActiveAt  DateTime?
  ssoSubject    String?  @unique            // from WorkOS SCIM
  // T&C acceptance captured when an invited user completes first sign-in
  // (AC-PM-007). Null for users who pre-date the invitation flow.
  termsAcceptedAt DateTime?
  termsVersion    String?
  // User's primary (home) tenant. Multi-tenant users have additional
  // memberships; this is just where they land on sign-in by default.
  // Nullable because super-admins at the platform level don't need one.
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  memberships       Membership[]
  invitations       UserInvitation[]
  projectMemberships ProjectMember[]

  @@map("users")
  @@index([tenantId])
  @@index([status])
}

// One-time sign-up link for an invited user (AC-PM-007). Only the SHA-256
// of the token is stored; the raw token exists only in the link handed to
// the admin. Resending rotates the token by revoking the prior row.
model UserInvitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedBy   String?
  createdAt   DateTime  @default(now())

  @@map("user_invitations")
  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?

  @@map("sessions")
  @@index([userId])
  @@index([expiresAt])
}

// --------------------------------------------------------------------------
// Projects (Phase 1 Week 3 — real)
// Mirrors apps/web/src/data/study.json + studyTB.json shape
// --------------------------------------------------------------------------

model Project {
  id                   String    @id
  // Tenant scoping. Nullable through the FK transition — the Arc 2
  // backfill migration promotes legacy String values into real Tenant
  // rows + rewrites the FK target. Post-backfill, new rows should
  // always carry a tenantId.
  tenantId             String?
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name                 String
  shortTitle           String
  client               String
  therapeuticArea      String
  indication           String?
  phase                String
  status               String    // initiated | ongoing | on-hold | re-open | closed
  startDate            DateTime
  dataCutoff           DateTime?
  activeModules        String[]  @default([])
  submissionCountries  String[]  @default([])
  referenceTrial       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  teamMembers          ProjectTeamMember[]
  members              ProjectMember[]

  @@map("projects")
  @@index([tenantId])
  @@index([status])
  @@index([therapeuticArea])
}

// LEGACY — see ProjectMember below. Kept during cutover so the demo-data
// seed and existing /raci routes don't need to move in lockstep with the
// unified-RBAC migration. Will be dropped once all callers migrate to
// ProjectMember + DocumentRaci.
model ProjectTeamMember {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  userId      String
  role        String  // 'Lead Clinical Writer' etc.
  raci        String  // 'R' | 'A' | 'C' | 'I'
  colourKey   String?
  initials    String?
  name        String  // denormalised for display without a join

  @@map("project_team_members")
  @@unique([projectId, userId])
}

// --------------------------------------------------------------------------
// Unified RBAC — ProjectMember + GuestInvitation
// Introduced by migration 47 (unified_rbac_schema). Rules + semantics in
// docs/roles-and-permissions.md §3.1 and §6.
// --------------------------------------------------------------------------

// Project-level membership. Being a ProjectMember gives read access to the
// project; per-document capability comes from DocumentRaci (see moduleA.prisma).
// `projectRole` is a free-text label for UI display only — it does NOT grant
// permissions.
model ProjectMember {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole   String?                                       // 'Lead Writer' | 'Medical Reviewer' | …
  addedBy       String                                        // User.id of the PM / admin who added them
  addedAt       DateTime  @default(now())
  removedAt     DateTime?

  @@map("project_members")
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// Time-boxed signed-URL access for external parties — KOL / sponsor reviewers,
// external statisticians, external SOC 2 auditors, regulatory inspectors.
// Two scopes share one table:
//   scope='document' → KOL / SME review on a single doc (read + comment)
//   scope='project'  → external auditor on all docs in a project (read-only + audit export)
// CHECK constraint enforces XOR between document_id and project_id (SQL
// migration — not expressible in Prisma schema language).
model GuestInvitation {
  id            String    @id @default(cuid())
  scope         String                                        // 'document' | 'project'
  documentId    String?                                       // set when scope='document'
  projectId     String?                                       // set when scope='project'
  email         String
  purpose       String                                        // 'kol-review' | 'sponsor-review' | 'external-stat' | 'external-audit' | 'other'
  invitedBy     String                                        // User.id of the inviter
  invitedAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  jwtText       String                                        // the signed token we handed to the guest

  @@map("guest_invitations")
  @@index([documentId])
  @@index([projectId])
  @@index([email])
  @@index([expiresAt])
}
