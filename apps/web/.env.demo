# Demo environment env file (deployed to demo.clinwrite.ai).
#
# Baked into the SPA bundle at build time by infra/standalone/scripts/
# deploy.sh via `VITE_API_URL=https://api.clinwrite.ai pnpm build`.
# This file documents the shape; the deploy script is the source of truth
# for the actual values that ship.

# ------- API wiring -------
VITE_API_URL=https://api.clinwrite.ai
VITE_AUTH_LOGIN_URL=https://api.clinwrite.ai/auth/login

# ------- Auth -------
# Demo environment: bypass auth so the prototype is immediately usable
# without a WorkOS tenant (procurement pending — see docs/pivot-plan.md
# "What blocks the AUTH cutover"). Flip to false when the SSO E2E
# runbook is complete + WORKOS_API_KEY is in /opt/platform/env/api.env.enc.
VITE_BYPASS_AUTH=true

# ------- MSW cutover (per-group) -------
# Default-on in dev; demo env flips groups off per the module cutover
# order. Current state: PROJECTS cut over to real API (shape-aligned in
# Batch 37; team array now included in response per packages/types
# Project interface).
VITE_MOCK_AUTH=on
VITE_MOCK_PROJECTS=off
VITE_MOCK_MODULE_A=off
VITE_MOCK_MODULE_B=off
VITE_MOCK_MODULE_C=off
VITE_MOCK_MODULE_D=off
VITE_MOCK_MODULE_E=off

# All five modules re-enabled 2026-10-08 per docs/pivot-plan.md Arc 11.
# Each module's deferrals memory (project_phase_3*_deferrals) lists the
# remaining external-blocker items; module appears in the UI with its
# shipped surface and shows a "pending integration" banner where a
# vendor is required (PubMed/CrossRef/ORCID for B, FDA ESG/EMA CESP
# for D, etc.).
VITE_MODULES_ENABLED=A,B,C,D,E

VITE_APP_NAME="ClinWrite.AI (Demo)"
VITE_MOCK_DELAY_MS=100
