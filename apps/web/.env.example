# Aurora/ClinWrite web app — environment variables.
# Copy to .env.local for local dev; values below are Vite-safe defaults.

# ------- API wiring -------
# Base URL of the Fastify API. Leave as '/api' to let MSW intercept during
# cutover; point at a real host (e.g. https://qa-api.clinwrite.ai) once at
# least one module group is set to VITE_MOCK_<group>=off.
VITE_API_URL=/api

# Where /auth/login lives. Defaults to `${VITE_API_URL}/auth/login`; override
# only if the login page lives on a different host.
VITE_AUTH_LOGIN_URL=

VITE_APP_NAME=ClinWrite.AI
VITE_MOCK_DELAY_MS=200

# ------- MSW handler group toggles (Phase 2 cutover) -------
# Values: on (default) | off | force
#   on     — register the mock handlers (prototype demo mode)
#   off    — skip the group; requests fall through to the real API
#   force  — stay mocked even when VITE_API_URL points at a real backend
#
# Expected cutover order per the implementation plan:
#   1. Flip VITE_MOCK_AUTH=off once Phase 2 auth round-trip is wired.
#   2. Flip VITE_MOCK_PROJECTS=off once /projects + /admin/users are live.
#   3. Flip VITE_MOCK_MODULE_A..E=off per phase 3A–3E as each backend ships.

VITE_MOCK_AUTH=on
VITE_MOCK_PROJECTS=on
VITE_MOCK_MODULE_A=on
VITE_MOCK_MODULE_B=on
VITE_MOCK_MODULE_C=on
VITE_MOCK_MODULE_D=on
VITE_MOCK_MODULE_E=on
