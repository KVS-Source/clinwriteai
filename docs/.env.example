# ════════════════════════════════════════════════════════════════════════
# GenRAC API — environment configuration template
#
# Copy this file to `.env` (gitignored) and fill in real values:
#   cp .env.example .env
#
# Modules that read these vars at boot:
#   • app.module.ts → server, DB, Redis
#   • cross-cutting/magic-link → loadMagicLinkConfigFromEnv()
#   • cross-cutting/watermark → loadWatermarkConfigFromEnv()
#   • cross-cutting/file-storage → loadConfigFromEnv()
#   • modules/auth → cookie + login-flow + KMS
#
# Style Guide §12: NEVER commit real secrets. Anything marked
# `replace-me-...` MUST be replaced before production.
# ════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Postgres) ─────────────────────────────────────────
# Used by the Drizzle DB provider (apps/api/src/db.client.ts — to be wired).
# The connecting role MUST be a member of `genrac_app` so the request
# pipeline can SET ROLE genrac_app per tx (RLS enforcement).
#
# Schema prerequisites — these schemas must already exist:
#   tenant_settings, magic_link, user_management, auth_login
# (Run the foundation + per-module migrations before booting the API.)
DATABASE_URL=postgresql://genrac:genrac_dev@localhost:5432/genrac

# Optional — for integration tests using a separate test database.
# GENRAC_TEST_PG_URL=postgresql://genrac:genrac_dev@localhost:5432/genrac_test

# ── Redis ───────────────────────────────────────────────────────
# Consumers:
#   - MagicLinkService.BruteForceProtector (sliding-window counters)
#   - AuthService.SigningContextRepository (Part 11 signing context)
#   - AuthService session-store (live session state — sole source of truth)
REDIS_URL=redis://localhost:6379

# Optional — separate Redis DB for integration tests.
# GENRAC_TEST_REDIS_URL=redis://localhost:6379/1

# ── SSO Phase 2 — this backend's own public base URL (NOT the frontend) ──
# Used to build the SP entity ID + per-tenant ACS URL:
#   ${GENRAC_API_BASE_URL}/api/v1/auth/sso/callback/:tenantId
GENRAC_API_BASE_URL=http://localhost:3000

# ── SSO Phase 2 — frontend base URL for the ACS callback's post-processing
# redirect (dashboard / MFA challenge / error). Same value as
# GENRAC_MAGIC_LINK_BASE_URL below in practice; kept independent per-feature.
GENRAC_FRONTEND_BASE_URL=http://localhost:5173

# ── Magic Link Service (cross-cutting Service 07) ──────────────
# Required. Must include http:// or https:// scheme.
#
# This is your FRONTEND base URL, not the API. The service builds full
# magic-link URLs as `{baseUrl}/{actionPrefix}/{token}`; the recipient's
# browser then requests those paths, which are handled by the SPA
# (apps/web) — served by Vite in local dev, by nginx in staging/prod.
#
# Local dev:    http://localhost:5173         (Vite default port)
# Staging/prod: https://your-public-hostname  (no port; nginx on 443)
#
# Historical footgun: the earlier default `http://localhost:3000` (the
# API port) silently broke every magic-link email because the browser
# would try to load the SPA from the API's port and hit a JSON 404.
# Same footgun applies with `:5173` on staging (Vite doesn't run there).
GENRAC_MAGIC_LINK_BASE_URL=http://localhost:5173

# Optional — defaults from DEFAULT_CONFIG in magic-link/types.ts.
# Uncomment to override.
# GENRAC_MAGIC_LINK_TOKEN_BYTES=32
# GENRAC_MAGIC_LINK_BRUTE_FORCE_WINDOW_SECONDS=300
# GENRAC_MAGIC_LINK_BRUTE_FORCE_THRESHOLD=10
# GENRAC_MAGIC_LINK_LOCKOUT_DURATION_SECONDS=900
# GENRAC_MAGIC_LINK_EXPIRATION_SWEEP_INTERVAL_SECONDS=3600
# GENRAC_MAGIC_LINK_LOCKOUT_RESET_INTERVAL_SECONDS=300
# GENRAC_MAGIC_LINK_MAX_SCOPE_BYTES=8192
# GENRAC_MAGIC_LINK_FAILED_CONSUME_AUDIT_WINDOW_SECONDS=60

# Feature flag — disable brute-force protection in dev to avoid rate-limit
# noise during manual testing. MUST be `true` in any staging/prod env.
GENRAC_FEATURE_MAGIC_LINK_BRUTE_FORCE_ENABLED=true

# ── Auth Module (Module 02 — Part 11 path) ─────────────────────
# Session cookie attributes. The controller currently hardcodes these
# (httpOnly, secure, sameSite=lax); a future wiring step will read these
# env vars instead so deploy environments can override per environment.
AUTH_SESSION_COOKIE_NAME=__Host-genrac-session
# 20 min per 2026-05-28 user direction (was 900 / 15 min). Aligns with
# tenant_settings.idle_timeout_minutes default (20) + frontend
# useIdleTimer.IDLE_TIMEOUT_MS (20 * 60 * 1000). Activity events
# (mousedown/keydown/touchstart/scroll) reset the timer on the frontend.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1200
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Cookie signing secret. Required when cookie-parser is wired to verify
# the session cookie hasn't been tampered with at the edge. MUST be at
# least 32 bytes of entropy in production.
AUTH_SESSION_COOKIE_SECRET=replace-me-at-least-32-bytes-of-entropy-required

# ── Session-token cross-cutting service (HS256-signed JWT) ─────
# JWT-Hardening arc (W1 fbafd08 → W5) replaced the prior MVP base64-JSON
# stubs with HS256 (HMAC-SHA256) signed JWTs via the cross-cutting
# SessionTokenService (apps/api/src/cross-cutting/session-token/).
# Per-purpose separate secrets (smaller blast radius if one leaks).
# MUST each be at least 32 bytes of entropy (256 bits — HS256
# best-practice key size; loader rejects shorter values at boot).
#
# Consumers:
#   loginFlow secret → M02 AuthService.mintLoginFlowToken /
#                      verifyLoginFlowToken (MFA mid-flow continuation)
#   redeem secret    → M02 AuthService.mintRedeemSessionToken (mints
#                      after magic-link redeem) + M14 ReportsService
#                      .validateSessionToken (verifies on view-only-access)
AUTH_LOGIN_FLOW_TOKEN_SECRET=replace-me-at-least-32-bytes-of-entropy-required
AUTH_LOGIN_FLOW_TOKEN_TTL_SECONDS=300

AUTH_REDEEM_SESSION_TOKEN_SECRET=replace-me-at-least-32-bytes-of-entropy-required
AUTH_REDEEM_SESSION_TOKEN_TTL_SECONDS=3600

# ssoState secret → SSO Phase 2. Signs RelayState between POST /auth/initiate
# (mint) and POST /auth/sso/callback/:tenantId (verify) — CSRF/state-tamper
# defense for the SAML redirect round trip.
AUTH_SSO_STATE_TOKEN_SECRET=replace-me-at-least-32-bytes-of-entropy-required
AUTH_SSO_STATE_TOKEN_TTL_SECONDS=300

# KMS for MFA secret encryption-at-rest. Currently a passthrough stub
# (sentinel ARN `arn:dev:passthrough`); MUST be a real KMS key ARN
# before production deploy.
AUTH_KMS_KEY_ARN=arn:dev:passthrough

# Account lockout — per spec §7.5.
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=30

# Password rotation — privileged roles (admin_user, superuser, qa_head)
# must rotate every N days. Triggers AUTH-423-PWROT on login if overdue.
AUTH_PASSWORD_ROTATION_DAYS_PRIVILEGED=90

# Google siteverify ALWAYS returns success for these keys — dev/CI only.
# The widget renders and accepts the checkbox on any domain/device.
# Reference: https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha-v2-what-should-i-do
#
# PROD: register a real site at https://www.google.com/recaptcha/admin/create
# (reCAPTCHA v2 → "I'm not a robot"; add every hostname users access from).
# Replace BOTH keys below with the real site/secret key pair.
# VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ── Watermark Service (cross-cutting Service 08) ───────────────
# Optional — defaults from DEFAULT_CONFIG in watermark/types.ts.
# GENRAC_WATERMARK_SYNC_THRESHOLD_PAGES=50
# GENRAC_WATERMARK_MAX_SOURCE_BYTES=104857600
# GENRAC_WATERMARK_MAX_LOGO_BYTES=5242880
# GENRAC_WATERMARK_PREVIEW_TTL_SECONDS=3600
# GENRAC_WATERMARK_HEALTH_CHECK_TIMEOUT_MS=5000
GENRAC_FEATURE_WATERMARK_ENABLED=true

# ── File Storage (cross-cutting Service 05) ────────────────────
# Deployment mode selects which S3-compatible adapter is wired:
#   saas         → AWS S3 (production)
#   on_prem      → MinIO (self-hosted; needs ENDPOINT below)
#   client_cloud → Customer-managed S3 (needs ENDPOINT + ACCESS_KEY)
GENRAC_DEPLOYMENT_MODE=on_prem
GENRAC_FILE_STORAGE_BUCKET_NAME=genrac-files-dev
GENRAC_FILE_STORAGE_S3_REGION=us-east-1
# Override S3 endpoint (MinIO localhost / LocalStack / customer-managed).
# Leave empty for AWS S3 production.
GENRAC_FILE_STORAGE_S3_ENDPOINT=http://localhost:9000
GENRAC_FILE_STORAGE_ACCESS_KEY_ID=replace-me
GENRAC_FILE_STORAGE_SECRET_ACCESS_KEY=replace-me

# ── Job Queue (cross-cutting Service 04) ───────────────────────
# BullMQ uses the same Redis instance unless overridden.
# GENRAC_JOB_QUEUE_REDIS_URL=redis://localhost:6379/2
GENRAC_JOB_QUEUE_CONCURRENCY=4
# Local-dev escape hatch when Redis isn't running:
# - true (default) — workers register + connect to Redis; enqueue calls
#   hit BullMQ. Background jobs run.
# - false — registerWorker() + enqueue calls become no-ops returning a
#   synthetic disabled-jobId. apps/api boots without Redis log spam;
#   jobs are silently skipped (no retry, no DLQ).
# GENRAC_JOB_QUEUE_ENABLED=true

# ── Audit Log (cross-cutting Service 02) ───────────────────────
# Hash-chain partition rotation cadence.
# GENRAC_AUDIT_LOG_PARTITION_ROTATION_CRON=0 0 1 * *

# ── Notification (cross-cutting Service 12) ───────────────────
# Deployment mode controls which email adapter handles delivery.
# - on_prem → SMTP via nodemailer (NOTIFICATION_SMTP_* env vars below).
# - saas    → AWS SES via @aws-sdk/client-sesv2.
# GENRAC_DEPLOYMENT_MODE=on_prem

# Master gate. When false the adapter logs but does NOT actually send;
# safe to leave on for dev environments without real SMTP/SES creds.
# NOTIFICATION_REAL_SEND=false

NOTIFICATION_FROM_NAME=GenRAC
NOTIFICATION_FROM_ADDRESS=noreply@genrac.local

# Opt-out + preferences URL host reuses GENRAC_MAGIC_LINK_BASE_URL
# defined above — no separate variable. If you change the frontend
# base URL for staging/prod, unsubscribe links in outbound emails
# automatically pick up the new host.

# SMTP adapter (on_prem deployment mode) — see email.adapter.ts.
# Port 465 = implicit TLS; 587/25 = STARTTLS.
# NOTIFICATION_SMTP_HOST=smtp.example.com
# NOTIFICATION_SMTP_PORT=465
# NOTIFICATION_SMTP_SECURE=true
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASSWORD=

# SES adapter (saas deployment mode). Standard AWS SDK env vars apply:
# AWS_REGION (defaults to us-east-1 if unset)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for static creds, OR
# leave both unset and run with an IAM instance/task role for
# credential discovery via the AWS SDK default chain. The identity
# must have ses:SendEmail on the configured FROM address.
# AWS_REGION=us-east-1

# Opt-out token HMAC secret. ≥32 chars in production. Dev fallback
# kicks in below 32 chars or when unset (with a warning at boot).
# GENRAC_NOTIFICATION_OPTOUT_HMAC_SECRET=
