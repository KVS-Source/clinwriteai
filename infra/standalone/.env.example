# Env vars read by docker-compose (prod/staging VPS).
# For local dev, docker-compose.local.yml uses hardcoded defaults — this file
# is only read on the VPS.
#
# On the VPS this file lives at /opt/platform/env/.env (unencrypted, low-sensitivity)
# alongside .env.enc (sops-encrypted, high-sensitivity secrets consumed by apps).

# ----- Postgres -----
POSTGRES_USER=platform
POSTGRES_PASSWORD=   # set via sops rotation
POSTGRES_DB=platform

# ----- Redis -----
REDIS_PASSWORD=   # set via sops rotation

# ----- MinIO -----
MINIO_ROOT_USER=   # set via sops rotation
MINIO_ROOT_PASSWORD=   # set via sops rotation

# ----- Grafana -----
GRAFANA_ADMIN_PASSWORD=   # set via sops rotation
