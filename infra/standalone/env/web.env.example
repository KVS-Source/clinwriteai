# Phase 2 cutover flags consumed by deploy.sh at web-bundle build time.
#
# File location on the VPS: /opt/platform/env/web.env (plain, non-secret).
# Rebuild + redeploy after editing — Vite bakes these into the bundle, so
# flipping a flag requires a redeploy, not a config reload.
#
# Values: on | off | force (see docs/adr/0007 for the cutover doctrine).
#
# Cutover order per docs/architecture-implementation-plan.md:
#   1. VITE_MOCK_AUTH=off           — Phase 2 completes, auth round-trip live.
#   2. VITE_MOCK_PROJECTS=off       — Phase 2 completes, /projects + /admin/users live.
#   3. VITE_MOCK_MODULE_A..E=off    — Flip as each Phase 3 module ships.

VITE_API_URL=https://qa-api.clinwrite.ai
VITE_AUTH_LOGIN_URL=https://qa-api.clinwrite.ai/auth/login

VITE_MOCK_AUTH=on
VITE_MOCK_PROJECTS=on
VITE_MOCK_MODULE_A=on
VITE_MOCK_MODULE_B=on
VITE_MOCK_MODULE_C=on
VITE_MOCK_MODULE_D=on
VITE_MOCK_MODULE_E=on

# Staging-only: show the cutover status badge so QA testers can see which
# routes are mocked vs live. Hidden by default in prod builds.
VITE_SHOW_CUTOVER_BADGE=on
VITE_SHOW_RQ_DEVTOOLS=on
