{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Audit chain",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "platform_audit_chain_intact", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "BROKEN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "INTACT", "color": "green" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Last chain verify",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "(time() - platform_audit_chain_last_verify_seconds) / 3600",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "red",    "value": 48 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Access review (days ago)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "(time() - platform_access_review_last_export_seconds) / 86400",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red",    "value": 35 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Backup drill (days ago)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "(time() - platform_backup_drill_last_success_seconds) / 86400",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red",    "value": 32 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Audit events / hour by actor",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (actor_id) (increase(platform_audit_events_total[1h]))", "refId": "A", "legendFormat": "{{actor_id}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit events / hour by entity type",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (entity_type) (increase(platform_audit_events_total[1h]))", "refId": "A", "legendFormat": "{{entity_type}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI call PII scrub rate",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(platform_ai_calls_total{pii_scrubbed=\"true\"}[1h])) / sum(rate(platform_ai_calls_total[1h]))",
          "refId": "A",
          "legendFormat": "scrubbed %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Rate-limited AI calls",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(platform_ai_calls_total{limit_decision=\"rejected_cap\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    }
