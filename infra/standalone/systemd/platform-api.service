# systemd unit for the Fastify API service.
# Install path on VPS: /etc/systemd/system/platform-api.service
# Enable + start:
#   systemctl daemon-reload
#   systemctl enable --now platform-api
#
# Logs:
#   journalctl -u platform-api -f

[Unit]
Description=Platform API (Fastify) — Aurora/ClinWrite
Documentation=https://github.com/KVS-Source/clinwriteai
After=network.target docker.service
Wants=docker.service
# Depends on Postgres + Redis being up (via Compose)
Requires=platform-data.target
After=platform-data.target

[Service]
Type=simple
User=platform
Group=platform
# Run directly out of the repo tree. The monorepo's hoisted
# node_modules sit at /opt/platform/repo/node_modules; node's
# require resolution walks up from apps/api/dist and finds them.
# Keeps us out of the npm-ci-with-no-lockfile trap that comes from
# trying to re-install into a separate /opt/platform/apps/api dir.
WorkingDirectory=/opt/platform/repo/apps/api

# Resolve envs from the sops-decrypted + plain .env files
# (scripts/decrypt-env.sh runs via ExecStartPre and writes a tmpfs file)
ExecStartPre=/opt/platform/scripts/decrypt-env.sh api
EnvironmentFile=/run/platform/api.env

ExecStart=/usr/bin/node dist/server.js

Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Graceful shutdown — Fastify handles SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=30

# Health check gate before marking service as ready. ${PORT} is expanded
# from EnvironmentFile=/run/platform/api.env (PORT=3001 by default, but
# operators can override — nginx on this VPS fronts the API on 3011, so
# the env has PORT=3011). Hardcoding 3001 here breaks start-up on any
# VPS where PORT was tweaked, because the health probe times out even
# while the API is serving requests on the real port.
ExecStartPost=/opt/platform/scripts/wait-for-health.sh http://127.0.0.1:${PORT}/health 60

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# ReadWritePaths — ProtectSystem=strict makes the entire filesystem
# read-only except these dirs. Must include /opt/platform/data/blob so
# BLOB_PROVIDER=local can write uploaded documents / voice notes /
# exports / eCTD bundles under /opt/platform/data/blob/<bucket>/…
# Without the blob path the upload route 500s with
#   ENOENT: no such file or directory, mkdir '/opt/platform/data/blob/documents/…'
# even after deploy.sh pre-creates the dirs — the kernel enforces the
# write-protection regardless of filesystem perms.
ReadWritePaths=/var/log/platform /run/platform /opt/platform/data/blob
# Allow network for API calls (Anthropic, WorkOS, SendGrid, etc.)
RestrictNetworkInterfaces=
# Resource limits
LimitNOFILE=65536
MemoryMax=4G

# Logging — stdout/stderr to journald → shipped to Loki by promtail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=platform-api

[Install]
WantedBy=multi-user.target
