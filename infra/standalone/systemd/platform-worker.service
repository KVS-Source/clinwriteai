# systemd unit for the BullMQ worker service (ADR 0008).
# Install path on VPS: /etc/systemd/system/platform-worker.service

[Unit]
Description=Platform Worker (BullMQ) — Aurora/ClinWrite
Documentation=https://github.com/KVS-Source/clinwriteai
After=network.target platform-data.target
Requires=platform-data.target

[Service]
Type=simple
User=platform
Group=platform
WorkingDirectory=/opt/platform/repo/apps/worker

ExecStartPre=/opt/platform/scripts/decrypt-env.sh worker
EnvironmentFile=/run/platform/worker.env

# Health HTTP server port (Batch 27). External orchestrators probe
# /health (liveness) and /ready (Postgres + Redis dependency checks) here.
Environment="WORKER_HEALTH_PORT=3002"

# Entry point is apps/worker/dist/index.js (tsc --build output).
# The earlier dist/worker.js filename didn't match the build output
# and would fail with ENOENT — caught during Batch 27 health wiring review.
ExecStart=/usr/bin/node dist/index.js

Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# Graceful shutdown — worker drains in-flight jobs on SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=120

# Hardening (same posture as API)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/log/platform /run/platform

LimitNOFILE=65536
MemoryMax=8G       # workers run heavier (AI calls hold context in memory)

StandardOutput=journal
StandardError=journal
SyslogIdentifier=platform-worker

[Install]
WantedBy=multi-user.target
